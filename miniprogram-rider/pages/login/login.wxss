.login-page { padding: 120rpx 60rpx; }
.login-header { text-align: center; margin-bottom: 60rpx; }
.title { font-size: 44rpx; font-weight: bold; display: block; }
.subtitle { font-size: 28rpx; color: #999; margin-top: 16rpx; display: block; }
.form { background: #fff; border-radius: 16rpx; padding: 0 24rpx; margin-bottom: 40rpx; }
.form-item { padding: 24rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.form-item:last-child { border-bottom: none; }
.label { display: block; font-size: 26rpx; color: #999; margin-bottom: 12rpx; }
.form-item input { font-size: 32rpx; }
.pwd-row { display: flex; align-items: center; }
.pwd-input { flex: 1; }
.pwd-eye { padding: 0 16rpx; font-size: 36rpx; }
.toggle { text-align: center; margin-top: 30rpx; color: #FF9800; font-size: 28rpx; }
.login-tips { font-size: 24rpx; color: #999; margin-top: 30rpx; }
.login-tips .link { color: #FF9800; }
.tips-checkbox-row { display: flex; align-items: center; flex-wrap: wrap; justify-content: center; }
.checkbox { width: 36rpx; height: 36rpx; border: 2rpx solid #ccc; border-radius: 50%; margin-right: 8rpx; display: flex; align-items: center; justify-content: center; font-size: 22rpx; color: #fff; background: #fff; }
.checkbox.checked { background: #FF9800; border-color: #FF9800; }
.tips-text { font-size: 24rpx; color: #999; }
.btn-primary[disabled] { opacity: 0.5; }
