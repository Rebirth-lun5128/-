.status-card { text-align: center; }
.order-no { font-size: 26rpx; color: #999; display: block; }
.order-status { font-size: 32rpx; font-weight: bold; display: block; margin-top: 10rpx; color: #FF6B35; }
.store-count { font-size: 24rpx; color: #FF9800; margin-top: 6rpx; display: block; }

.section-title { font-size: 28rpx; font-weight: bold; display: block; margin-bottom: 16rpx; color: #333; }
.contact { font-size: 30rpx; font-weight: bold; display: block; }
.addr { display: block; font-size: 26rpx; color: #666; margin-top: 8rpx; }

/* 子单头部 */
.sub-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.shop-name { font-size: 30rpx; font-weight: bold; }
.sub-status { font-size: 24rpx; }

/* 菜品 */
.item { display: flex; justify-content: space-between; padding: 10rpx 0; }
.item-name { font-size: 26rpx; color: #333; }
.sub-total-row { display: flex; justify-content: space-between; padding-top: 12rpx; margin-top: 8rpx; border-top: 1rpx solid #f5f5f5; }

/* 费用 */
.fee-row { display: flex; justify-content: space-between; padding: 10rpx 0; font-size: 26rpx; }
.fee-row.total { border-top: 1rpx solid #eee; margin-top: 8rpx; padding-top: 16rpx; font-weight: bold; }
.discount { color: #E53935; }
.final { color: #FF6B35; font-size: 32rpx; }

/* 订单信息 */
.info-row { display: flex; justify-content: space-between; padding: 10rpx 0; font-size: 24rpx; color: #666; }

/* 子单时间线 */
.sub-timeline { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f5f5f5; }
.tl-item { display: flex; padding-left: 16rpx; position: relative; }
.tl-item:not(:last-child) { padding-bottom: 24rpx; }
.tl-dot {
  width: 16rpx; height: 16rpx; border-radius: 50%; background: #FF6B35;
  margin-top: 6rpx; margin-right: 16rpx; flex-shrink: 0;
}
.tl-item:not(:last-child) .tl-dot::after {
  content: ''; position: absolute; left: 23rpx; top: 24rpx;
  width: 2rpx; height: calc(100% - 8rpx); background: #FFE0CC;
}
.tl-content { flex: 1; }
.tl-desc { font-size: 26rpx; color: #333; display: block; }
.tl-time { font-size: 22rpx; color: #999; margin-top: 4rpx; display: block; }

/* 导航按钮 */
.nav-btn {
  margin-top: 16rpx; padding: 18rpx 0; text-align: center;
  background: linear-gradient(135deg, #2196F3, #64B5F6); color: #fff;
  font-size: 28rpx; font-weight: 600; border-radius: 44rpx;
}
.nav-btn:active { opacity: 0.85; }

/* 配送拍照 */
.delivery-photo {
  margin-top: 16rpx; text-align: center;
}
.photo-img {
  width: 100%; border-radius: 16rpx; max-height: 400rpx;
}
.photo-btn {
  margin-top: 12rpx; padding: 16rpx 32rpx; text-align: center;
  background: #E3F2FD; color: #2196F3; font-size: 26rpx;
  border-radius: 44rpx; border: 2rpx dashed #90CAF9;
}
