<view class="container" wx:if="{{order}}">
  <view class="card">
    <text class="order-no">订单号: {{order.order_no}}</text>
    <text class="status">{{order.status === 'delivering' ? '配送中' : order.status}}</text>
  </view>

  <view class="card">
    <text class="section-title">餐厅信息</text>
    <text class="shop-name">{{order.restaurant_name}}</text>
  </view>

  <view class="card">
    <text class="section-title">收货信息</text>
    <text>{{order.address_snapshot.contact_name}} {{order.address_snapshot.contact_phone}}</text>
    <text class="addr">{{order.address_snapshot.detail}}</text>
  </view>

  <view class="card">
    <text class="section-title">菜品</text>
    <view class="item" wx:for="{{order.items}}" wx:key="id">
      <text>{{item.name}} x{{item.quantity}}</text>
      <text class="price">{{item.price * item.quantity}}</text>
    </view>
    <view class="fee-row">
      <text>配送费</text><text class="price">{{order.delivery_fee}}</text>
    </view>
  </view>
</view>
