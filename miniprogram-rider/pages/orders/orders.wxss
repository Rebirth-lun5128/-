.order-card { padding: 0; overflow: hidden; }
.order-header { display: flex; justify-content: space-between; padding: 20rpx 24rpx; }
.shop { font-size: 28rpx; font-weight: bold; }
.addr { display: block; padding: 0 24rpx 16rpx; font-size: 26rpx; color: #666; border-bottom: 1rpx solid #f5f5f5; }
.order-footer { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 24rpx; }
.time { font-size: 24rpx; color: #999; }
