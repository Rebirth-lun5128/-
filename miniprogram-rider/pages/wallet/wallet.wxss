.balance-card {
  background: linear-gradient(135deg, #FF9800, #F57C00);
  border-radius: 20rpx;
  padding: 60rpx 0;
  text-align: center;
  color: #fff;
  margin-bottom: 20rpx;
}
.balance-label { font-size: 28rpx; display: block; opacity: 0.9; }
.balance-num { font-size: 80rpx; font-weight: bold; display: block; margin: 16rpx 0; }
.balance-extra { font-size: 26rpx; display: block; opacity: 0.8; }

.section-title { font-size: 28rpx; font-weight: bold; display: block; margin-bottom: 16rpx; }
.stat-row { display: flex; justify-content: space-between; padding: 16rpx 0; font-size: 28rpx; border-bottom: 1rpx solid #f5f5f5; }
.stat-row:last-child { border-bottom: none; }
