.status-bar { display: flex; justify-content: space-between; align-items: center; background: #fff; padding: 20rpx 24rpx; margin-bottom: 20rpx; border-radius: 16rpx; }
.status-info { display: flex; align-items: center; }
.status-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #ccc; margin-right: 12rpx; }
.status-dot.online { background: #4CAF50; }
.status-dot.busy { background: #FF9800; }

.current-order { border: 2rpx solid #FF9800; }
.section-title { font-size: 30rpx; font-weight: bold; display: block; margin-bottom: 16rpx; }
.order-no { font-size: 24rpx; color: #999; }
.addr-row { display: flex; margin: 10rpx 0; font-size: 26rpx; }
.addr-label { color: #999; width: 80rpx; }
.order-actions { display: flex; gap: 20rpx; margin-top: 20rpx; }
.order-actions > view { flex: 1; text-align: center; padding: 16rpx; border-radius: 44rpx; }
.btn-outline { border: 2rpx solid #ccc; color: #666; background: #fff; font-size: 26rpx; }

.pool-title { font-size: 28rpx; font-weight: bold; display: block; margin-bottom: 16rpx; }
.pool-item { padding: 0; overflow: hidden; }
.pool-header { display: flex; justify-content: space-between; padding: 20rpx 24rpx; border-bottom: 1rpx solid #f5f5f5; }
.shop { font-size: 30rpx; font-weight: bold; }
.pool-addrs { padding: 16rpx 24rpx; }
.pool-addr { display: block; font-size: 26rpx; color: #666; margin: 8rpx 0; }
.pool-footer { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 24rpx; border-top: 1rpx solid #f5f5f5; }
.distance { font-size: 26rpx; color: #999; }
