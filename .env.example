# Database - SQLite (default) or MySQL
# For SQLite (development):
DATABASE_URL=sqlite:///./food_delivery.db
# For MySQL (production in Docker):
# DATABASE_URL=mysql+pymysql://root:root@mysql:3306/food_delivery?charset=utf8mb4

# JWT
SECRET_KEY=change-me-in-production-please

# WeChat Mini Program
WECHAT_APPID=
WECHAT_SECRET=

# WeChat Pay (JSAPI / 小程序支付)
WECHAT_PAY_MCHID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/common/pay/notify

# MySQL (only needed with --profile mysql)
MYSQL_ROOT_PASSWORD=root

# File upload
UPLOAD_DIR=./uploads

# 阿里云 OSS（可选 — 不配则使用本地存储，建议生产环境配置）
# RAM 用户需有 AliyunOSSFullAccess 权限
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY_ID=LTAI5txxxxxxxxxx
# OSS_ACCESS_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OSS_BUCKET_NAME=your-bucket-name
# OSS_URL_BASE=https://cdn.your-domain.com  # CDN 域名（可选，不配则用 OSS 默认域名）

# Redis (optional — for production rate limiting)
# REDIS_URL=redis://redis:6379/0

# Admin web port
ADMIN_PORT=80
