page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: #333;
  background: #f5f5f5;
}

.container {
  padding: 20rpx;
}

/* 通用按钮 */
.btn-primary {
  background: #FF6B35;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  padding: 24rpx 0;
  text-align: center;
}

.btn-outline {
  border: 2rpx solid #FF6B35;
  color: #FF6B35;
  background: #fff;
  border-radius: 44rpx;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
}

.btn-sm {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

/* 价格 */
.price {
  color: #FF6B35;
  font-weight: bold;
}
.price::before {
  content: '¥';
  font-size: 24rpx;
}

.original-price {
  color: #999;
  text-decoration: line-through;
  font-size: 24rpx;
  margin-left: 10rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
}

.tag-orange {
  background: #FFF3ED;
  color: #FF6B35;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #999;
}
.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}
