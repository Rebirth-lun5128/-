.page-bg {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 头部卡片 */
.header-card {
  background: linear-gradient(135deg, #FF6B35, #FF8C5A);
  padding: 60rpx 28rpx 40rpx;
  margin-bottom: 20rpx;
}
.header-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 32rpx;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.4);
  background: rgba(255,255,255,0.3);
  flex-shrink: 0;
}
.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.nickname {
  font-size: 38rpx;
  font-weight: bold;
  color: #fff;
}
.phone {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}
.header-edit {
  padding: 12rpx;
}
.edit-icon {
  font-size: 36rpx;
  color: rgba(255,255,255,0.7);
}

/* 统计行 */
.stats-row {
  display: flex;
  justify-content: space-around;
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 24rpx 8rpx;
}
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.stat-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}
.stat-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 20rpx 20rpx;
  padding: 24rpx;
}
.card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: bold;
}
.card-link {
  font-size: 26rpx;
  color: #999;
}

/* 订单快捷栏 */
.order-quick {
  display: flex;
  justify-content: space-around;
}
.order-quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.oq-icon {
  font-size: 44rpx;
}
.oq-label {
  font-size: 24rpx;
  color: #666;
}

/* 服务网格 */
.service-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 0;
}
.service-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  gap: 12rpx;
}
.svc-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.svc-icon-wrap.addr { background: #E3F2FD; }
.svc-icon-wrap.coupon { background: #FFF3E0; }
.svc-icon-wrap.fav { background: #FCE4EC; }
.svc-icon-wrap.cart { background: #E8F5E9; }
.svc-icon-wrap.contact { background: #F3E5F5; }
.svc-icon-wrap.about { background: #ECEFF1; }
.svc-icon {
  font-size: 36rpx;
}
.svc-label {
  font-size: 24rpx;
  color: #666;
}

/* 退出 */
.logout-btn {
  text-align: center;
  padding: 28rpx;
  margin-top: 30rpx;
  color: #999;
  font-size: 28rpx;
}
