.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}
.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  margin-bottom: 20rpx;
  background: #eee;
}
.nickname {
  font-size: 36rpx;
  font-weight: bold;
}
.phone {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.menu-group {
  padding: 0;
  margin-top: 20rpx;
}
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 30rpx;
}
.menu-item:last-child {
  border-bottom: none;
}
.arrow {
  color: #ccc;
}

.logout-btn {
  text-align: center;
  padding: 24rpx;
  margin-top: 60rpx;
  color: #999;
  font-size: 28rpx;
}
