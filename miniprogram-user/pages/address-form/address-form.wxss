.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.form-item:last-child {
  border-bottom: none;
}
.label {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
}
.form-item input {
  font-size: 30rpx;
  padding: 10rpx 0;
}
.radio-label {
  margin-right: 40rpx;
  font-size: 28rpx;
}
.switch-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
