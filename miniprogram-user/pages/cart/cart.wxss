.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 空购物车 */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}
.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}
.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 16rpx;
}
.empty-tip {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 60rpx;
}
.go-home-btn {
  width: 300rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 30rpx;
}

/* 购物车分组 */
.cart-group {
  margin: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.cart-restaurant {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.restaurant-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.clear-btn {
  font-size: 26rpx;
  color: #999;
}

/* 菜品项 */
.cart-item {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  position: relative;
}
.cart-item-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}
.cart-item-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.cart-item-name {
  font-size: 28rpx;
  color: #333;
}
.cart-item-price {
  font-size: 26rpx;
  color: #FF6B35;
  font-weight: bold;
}
.cart-item-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-right: 40rpx;
}
.remove-btn {
  position: absolute;
  right: 20rpx;
  font-size: 24rpx;
  color: #ccc;
  padding: 10rpx;
}

/* 数量控制按钮 */
.qty-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #f5f5f5;
  font-size: 28rpx;
  color: #333;
}
.qty-num {
  font-size: 28rpx;
  color: #333;
  min-width: 40rpx;
  text-align: center;
}

/* 底部结算 */
.cart-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}
.subtotal-label {
  font-size: 26rpx;
  color: #666;
}
.subtotal-price {
  font-size: 32rpx;
  color: #FF6B35;
  font-weight: bold;
}
.checkout-btn {
  width: 180rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 34rpx;
  font-size: 28rpx;
}

/* 通用主按钮 */
.btn-primary {
  background: #FF6B35;
  color: #fff;
}
