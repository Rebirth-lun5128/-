<view class="container">
  <!-- 空购物车 -->
  <view wx:if="{{isEmpty}}" class="empty-cart">
    <view class="empty-icon">🛒</view>
    <text class="empty-text">购物车是空的</text>
    <text class="empty-tip">快去选几样美食吧</text>
    <view class="btn-primary go-home-btn" bindtap="goHome">去逛逛</view>
  </view>

  <!-- 有商品 -->
  <view wx:else>
    <!-- 跨区提示 -->
    <view class="cross-warning" wx:if="{{crossDistrict}}">
      <text class="cross-warn-icon">⚠️</text>
      <text class="cross-warn-text">已选店铺跨越不同分区，需分开结算。请取消部分店铺后重试。</text>
    </view>

    <!-- 按分区展示 -->
    <view class="district-group" wx:for="{{districts}}" wx:key="district_id" wx:for-item="district">
      <view class="district-header">
        <text class="district-name">{{district.district_name}}</text>
        <text class="district-info">{{district.stores.length}}家店</text>
      </view>

      <!-- 分区下的店铺 -->
      <view class="cart-group {{store.checked ? 'checked' : ''}}" wx:for="{{district.stores}}" wx:key="store_id" wx:for-item="store">
        <!-- 店铺头部（含勾选框） -->
        <view class="cart-restaurant">
          <view class="check-box" bindtap="toggleStore" data-sid="{{store.store_id}}">
            <view class="check-icon {{store.checked ? 'on' : ''}}">
              <text wx:if="{{store.checked}}">✓</text>
            </view>
          </view>
          <text class="restaurant-name">{{store.store_name}}</text>
          <text class="clear-btn" bindtap="clearStore" data-rid="{{store.store_id}}">清空</text>
        </view>

        <!-- 商品列表 -->
        <view class="cart-item" wx:for="{{store.items}}" wx:key="product_id" wx:for-item="item">
          <image class="cart-item-img" src="{{item.image || '/images/default-food.png'}}" mode="aspectFill" />
          <view class="cart-item-info">
            <text class="cart-item-name">{{item.name}}</text>
            <text class="cart-item-price">¥{{item.price}}</text>
          </view>
          <view class="cart-item-actions">
            <view class="qty-btn" bindtap="reduceItem" data-rid="{{store.store_id}}" data-item-id="{{item.product_id}}">-</view>
            <text class="qty-num">{{item.quantity}}</text>
            <view class="qty-btn" bindtap="addItem" data-rid="{{store.store_id}}" data-item-id="{{item.product_id}}">+</view>
          </view>
          <view class="remove-btn" bindtap="removeItem" data-rid="{{store.store_id}}" data-item-id="{{item.product_id}}">✕</view>
        </view>

        <view class="cart-footer">
          <text class="subtotal-label">小计</text>
          <text class="subtotal-price">¥{{store.subtotal}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部结算栏 -->
  <view class="submit-bar" wx:if="{{!isEmpty}}">
    <view class="submit-left">
      <text class="submit-count">已选{{selectedCount}}家店</text>
      <text class="submit-total">¥{{selectedTotal || '0.00'}}</text>
    </view>
    <view class="submit-btn {{crossDistrict || selectedIds.length === 0 ? 'disabled' : ''}}" bindtap="submitSelected">
      <text>{{crossDistrict ? '跨区需分开结算' : (selectedIds.length === 0 ? '请勾选店铺' : (selectedIds.length > 1 ? '合并结算' : '去结算'))}}</text>
    </view>
  </view>
</view>
