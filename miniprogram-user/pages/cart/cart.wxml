<view class="container">
  <!-- 空购物车 -->
  <view wx:if="{{isEmpty}}" class="empty-cart">
    <view class="empty-icon">🛒</view>
    <text class="empty-text">购物车是空的</text>
    <text class="empty-tip">快去选几样美食吧</text>
    <view class="btn-primary go-home-btn" bindtap="goHome">去逛逛</view>
  </view>

  <!-- 购物车列表 -->
  <view wx:else>
    <view
      class="cart-group"
      wx:for="{{restaurants}}"
      wx:key="restaurant_id"
      wx:for-item="restaurant"
    >
      <!-- 餐厅名 -->
      <view class="cart-restaurant">
        <text class="restaurant-name">{{restaurant.restaurant_name}}</text>
        <text class="clear-btn" bindtap="clearRestaurant" data-rid="{{restaurant.restaurant_id}}">清空</text>
      </view>

      <!-- 菜品列表 -->
      <view
        class="cart-item"
        wx:for="{{restaurant.items}}"
        wx:key="menu_item_id"
        wx:for-item="item"
      >
        <image class="cart-item-img" src="{{item.image || '/images/default-food.png'}}" mode="aspectFill" />
        <view class="cart-item-info">
          <text class="cart-item-name">{{item.name}}</text>
          <text class="cart-item-price">¥{{item.price}}</text>
        </view>
        <view class="cart-item-actions">
          <view class="qty-btn" bindtap="reduceItem" data-rid="{{restaurant.restaurant_id}}" data-item-id="{{item.menu_item_id}}">-</view>
          <text class="qty-num">{{item.quantity}}</text>
          <view class="qty-btn" bindtap="addItem" data-rid="{{restaurant.restaurant_id}}" data-item-id="{{item.menu_item_id}}">+</view>
        </view>
        <view class="remove-btn" bindtap="removeItem" data-rid="{{restaurant.restaurant_id}}" data-item-id="{{item.menu_item_id}}">✕</view>
      </view>

      <!-- 小计 & 结算 -->
      <view class="cart-footer">
        <text class="subtotal-label">小计</text>
        <text class="subtotal-price">¥{{restaurant.subtotal}}</text>
        <view class="btn-primary checkout-btn" bindtap="goCheckout" data-rid="{{restaurant.restaurant_id}}">去结算</view>
      </view>
    </view>
  </view>
</view>
