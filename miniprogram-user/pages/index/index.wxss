/* ====== 全局容器 ====== */
.home {
  padding-bottom: 40rpx;
}

/* ====== 定位栏 ====== */
.location-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx;
  background: #fff;
}
.loc-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}
.loc-text {
  font-size: 26rpx;
  color: #666;
}

/* ====== 搜索栏 ====== */
.search-bar {
  display: flex;
  align-items: center;
  margin: 0 24rpx 16rpx;
  background: #f5f5f5;
  border-radius: 44rpx;
  padding: 16rpx 28rpx;
}
.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.scan-icon {
  font-size: 36rpx;
  margin-left: 16rpx;
  padding: 8rpx;
}

/* ====== Hero 轮播 ====== */
.hero-section {
  margin: 0 24rpx 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.hero-swiper {
  height: 260rpx;
}
.hero-slide {
  height: 260rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 36rpx;
}
.slide1 { background: linear-gradient(135deg, #FF6B35 0%, #FF8C5A 50%, #ffa073 100%); }
.slide2 { background: linear-gradient(135deg, #1a1940 0%, #2d2b6b 50%, #3d3588 100%); }
.slide3 { background: linear-gradient(135deg, #00b894 0%, #55efc4 100%); }

.hero-content {
  display: flex;
  flex-direction: column;
}
.hero-tag {
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
  background: rgba(255,255,255,0.2);
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  align-self: flex-start;
  margin-bottom: 12rpx;
}
.hero-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 8rpx;
}
.hero-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}
.hero-emoji {
  font-size: 80rpx;
}

/* ====== 品类图标 ====== */
.category-section {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 16rpx 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.03);
}
.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx 0;
}
.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}
.cate-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  margin-bottom: 8rpx;
}
.cate-name {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

/* ====== 热销推荐 ====== */
.featured-section {
  margin-bottom: 24rpx;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 28rpx 16rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}
.section-more {
  font-size: 24rpx;
  color: #FF6B35;
  font-weight: 500;
}
.featured-scroll {
  white-space: nowrap;
  padding: 0 24rpx;
}
.featured-item {
  display: inline-flex;
  flex-direction: column;
  width: 200rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}
.feat-img {
  width: 200rpx;
  height: 140rpx;
  background: #f0f0f0;
}
.feat-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  padding: 10rpx 12rpx 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.feat-meta {
  display: flex;
  gap: 10rpx;
  padding: 0 12rpx 12rpx;
}
.feat-rating {
  font-size: 22rpx;
  color: #FF9800;
}
.feat-sales {
  font-size: 22rpx;
  color: #bbb;
}

/* ====== 类型筛选 ====== */
.type-scroll {
  white-space: nowrap;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}
.type-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 14rpx;
  border-radius: 44rpx;
  font-size: 26rpx;
  background: #fff;
  color: #666;
  font-weight: 500;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04);
}
.type-item.active {
  background: linear-gradient(135deg, #FF6B35, #FF8C5A);
  color: #fff;
}

/* ====== 商家列表头 ====== */
.section-header-list {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 28rpx 16rpx;
}
.section-count {
  font-size: 24rpx;
  color: #bbb;
}

/* ====== 空状态 ====== */
.empty-icon {
  font-size: 60rpx;
  display: block;
  margin-bottom: 12rpx;
}

/* ====== 商家卡片 ====== */
.store-card {
  display: flex;
  background: #fff;
  margin: 0 24rpx 16rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.store-logo-img {
  width: 150rpx;
  height: 150rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}
.store-body {
  flex: 1;
  padding: 18rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}
.store-top-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.store-name-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}
.store-type-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
}
.tag-stall { background: #FFF3E0; color: #E65100; }
.tag-home_kitchen { background: #E8F5E9; color: #2E7D32; }
.tag-self_operated { background: #E3F2FD; color: #1565C0; }

.store-meta-row {
  display: flex;
  gap: 14rpx;
  font-size: 22rpx;
  color: #999;
}
.store-rating {
  color: #FF9800;
  font-weight: 500;
}
.store-tags-row {
  display: flex;
  gap: 10rpx;
}
.district-tag {
  font-size: 22rpx;
  color: #6C5CE7;
  background: #F4F2FF;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
}
.min-price-tag {
  font-size: 22rpx;
  color: #FF6B35;
  background: #FFF3ED;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
}
.delivery-tag {
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
}
.delivery-tag.free {
  color: #00B894;
  background: #E8F5E9;
}
.store-notice-text {
  font-size: 22rpx;
  color: #bbb;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ====== 加载 & 底部 ====== */
.loading-text, .no-more-text {
  text-align: center;
  padding: 24rpx;
  color: #ccc;
  font-size: 24rpx;
}

/* ====== 广告留白 ====== */
.ad-placeholder {
  margin: 24rpx 24rpx 20rpx;
  background: linear-gradient(135deg, #f8f9fc, #eef0f6);
  border: 2rpx dashed #d0d3dc;
  border-radius: 20rpx;
  padding: 4rpx;
}
.ad-inner {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 16rpx;
}
.ad-icon {
  font-size: 44rpx;
}
.ad-info {
  flex: 1;
}
.ad-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #999;
}
.ad-desc {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 4rpx;
}
.ad-arrow {
  font-size: 28rpx;
  color: #ddd;
}

/* ====== 优惠券悬浮按钮 ====== */
.coupon-fab {
  position: fixed;
  right: 30rpx;
  bottom: 180rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #FF6B35, #FF9800);
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}
.fab-icon {
  font-size: 40rpx;
}
