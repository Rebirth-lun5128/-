.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 60rpx 60rpx;
  min-height: 100vh;
  background: #fff;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
}
.login-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  margin-bottom: 30rpx;
  background: #FFF3ED;
}
.login-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}
.login-subtitle {
  font-size: 28rpx;
  color: #999;
  margin-top: 16rpx;
}

.login-buttons {
  width: 100%;
}
.login-btn {
  width: 100%;
  margin-bottom: 30rpx;
  padding: 28rpx 0;
  font-size: 32rpx;
}
.wechat-btn {
  background: #07C160;
}

.login-tips {
  font-size: 24rpx;
  color: #999;
  margin-top: 40rpx;
}
.login-tips .link {
  color: #FF6B35;
}
.tips-checkbox-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: center;
}
.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ccc;
  border-radius: 50%;
  margin-right: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  background: #fff;
}
.checkbox.checked {
  background: #FF6B35;
  border-color: #FF6B35;
}
.tips-text {
  font-size: 24rpx;
  color: #999;
}
