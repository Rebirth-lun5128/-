.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 60rpx 60rpx;
  min-height: 100vh;
  background: #fff;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
}
.login-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  margin-bottom: 30rpx;
  background: #FFF3ED;
}
.login-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}
.login-subtitle {
  font-size: 28rpx;
  color: #999;
  margin-top: 16rpx;
}

.login-buttons {
  width: 100%;
}
.login-btn {
  width: 100%;
  margin-bottom: 30rpx;
  padding: 28rpx 0;
  font-size: 32rpx;
}
.wechat-btn {
  background: #07C160;
}

.login-tips {
  font-size: 24rpx;
  color: #999;
  margin-top: 40rpx;
}
.login-tips .link {
  color: #FF6B35;
}
