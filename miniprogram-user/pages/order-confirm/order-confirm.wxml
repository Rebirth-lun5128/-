<view class="container">
  <!-- 收货地址 -->
  <view class="card address-card" bindtap="chooseAddress">
    <view wx:if="{{address}}">
      <view class="address-header">
        <text class="address-contact">{{address.contact_name}} {{address.contact_phone}}</text>
      </view>
      <view class="address-detail">
        <text wx:if="{{address.label}}" class="tag tag-orange">{{address.label}}</text>
        <text>{{address.province}}{{address.city}}{{address.district}}{{address.detail}}</text>
      </view>
    </view>
    <view wx:else class="no-address">
      <text>请选择收货地址</text>
      <text class="arrow">></text>
    </view>
  </view>

  <!-- 多店铺合并订单：每家店独立展示 -->
  <block wx:if="{{isCombined}}">
    <view class="card" wx:for="{{storeGroups}}" wx:key="store_id" wx:for-item="group">
      <view class="shop-info">
        <text class="shop-name">{{group.store_name}}</text>
      </view>
      <view class="order-item" wx:for="{{group.items}}" wx:key="product_id" wx:for-item="item">
        <text class="item-name">{{item.name}}</text>
        <text class="item-qty">x{{item.quantity}}</text>
        <text class="price">¥{{item.price * item.quantity}}</text>
      </view>
      <view class="subtotal-line">
        <text>小计</text>
        <text class="price">¥{{group.subtotal}}</text>
      </view>
    </view>
  </block>

  <!-- 单店订单 -->
  <block wx:else>
    <view class="card" wx:if="{{restaurant}}">
      <view class="shop-info">
        <image src="{{restaurant.logo || '/images/default-logo.png'}}" />
        <text>{{restaurant.name}}</text>
      </view>
    </view>

    <view class="card">
      <view class="item-title">菜品清单</view>
      <view class="order-item" wx:for="{{storeGroups[0].items}}" wx:key="product_id" wx:for-item="item">
        <image src="{{item.image || '/images/default-food.png'}}" mode="aspectFill" />
        <text class="item-name">{{item.name}}</text>
        <text class="item-qty">x{{item.quantity}}</text>
        <text class="price">¥{{item.price * item.quantity}}</text>
      </view>
    </view>
  </block>

  <!-- 优惠券选择 -->
  <view class="card coupon-card">
    <view class="section-header" bindtap="showCouponPicker">
      <text class="section-title">优惠券</text>
      <view class="section-right">
        <text wx:if="{{selectedCoupon}}" class="coupon-selected">{{selectedCoupon.name}} -¥{{selectedCoupon.discount_amount}}</text>
        <text wx:elif="{{coupons.length > 0}}" class="coupon-hint">有{{coupons.length}}张可用</text>
        <text wx:else class="coupon-none">暂无可用</text>
        <text class="arrow">></text>
      </view>
    </view>
  </view>

  <!-- 费用明细 -->
  <view class="card">
    <view class="fee-row">
      <text>菜品小计</text>
      <text class="price">¥{{itemsTotal}}</text>
    </view>
    <view wx:if="{{deliveryFeeDetail}}" class="fee-delivery-detail">
      <text>{{deliveryFeeDetail}}</text>
    </view>
    <view class="fee-row">
      <text>配送费</text>
      <text class="price">¥{{deliveryFee}}</text>
    </view>
    <view class="fee-row" wx:if="{{couponDiscount > 0}}">
      <text>优惠券抵扣</text>
      <text class="price discount">-¥{{couponDiscount}}</text>
    </view>
    <view class="fee-row total">
      <text>合计</text>
      <text class="price">¥{{totalPrice}}</text>
    </view>
    <view wx:if="{{deliveryFeeDiscount > 0}}" class="delivery-fee-tip">
      <text>🎉 {{deliveryFeeDetail}}</text>
    </view>
  </view>

  <!-- 备注 -->
  <view class="card">
    <input placeholder="订单备注 (选填)" value="{{remark}}" bindinput="onRemarkInput" />
  </view>

  <!-- 券选择弹窗 -->
  <view class="coupon-popup {{showCouponPopup ? 'show' : ''}}" catchtap="hideCouponPicker">
    <view class="popup-content" catchtap="noop">
      <view class="popup-title">选择优惠券</view>
      <view class="popup-scroll">
        <view
          class="coupon-option {{selectedCouponId === item.id ? 'active' : ''}} {{item.coupon_type === 'full_reduction' && itemsTotal < item.condition_amount ? 'disabled' : ''}}"
          wx:for="{{coupons}}"
          wx:key="id"
          bindtap="onSelectCoupon"
          data-item="{{item}}"
        >
          <view class="coupon-opt-left">
            <text class="coupon-opt-amount">¥{{item.discount_amount}}</text>
            <text class="coupon-opt-cond" wx:if="{{item.coupon_type === 'full_reduction'}}">满{{item.condition_amount}}可用</text>
            <text class="coupon-opt-cond" wx:else>无门槛</text>
          </view>
          <view class="coupon-opt-right">
            <text class="coupon-opt-name">{{item.name}}</text>
            <text class="coupon-opt-hint" wx:if="{{item.coupon_type === 'full_reduction' && itemsTotal < item.condition_amount}}">未满{{item.condition_amount}}元，不可用</text>
          </view>
          <view wx:if="{{selectedCouponId === item.id}}" class="coupon-check">✓</view>
        </view>
        <view wx:if="{{coupons.length === 0}}" class="empty-text">暂无可用优惠券</view>
        <view class="coupon-option no-use {{!selectedCouponId ? 'active' : ''}}" bindtap="onClearCoupon">
          <text>不使用优惠券</text>
          <view wx:if="{{!selectedCouponId}}" class="coupon-check">✓</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-bar">
    <view class="submit-info">
      <text wx:if="{{isCombined}}">{{storeGroups.length}}店合单: </text>
      <text wx:else>合计: </text>
      <text class="price">¥{{totalPrice}}</text>
    </view>
    <view class="btn-primary submit-btn" bindtap="submitOrder">提交订单</view>
  </view>
</view>
