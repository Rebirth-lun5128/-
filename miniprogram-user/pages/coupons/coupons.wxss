.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #999;
}
.tab.active {
  color: #FF6B35;
  font-weight: bold;
  border-bottom: 4rpx solid #FF6B35;
}

.coupon-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  position: relative;
  margin-bottom: 16rpx;
}
.coupon-left {
  width: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 2rpx dashed #eee;
  padding-right: 20rpx;
}
.coupon-amount {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF6B35;
}
.coupon-condition {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}
.coupon-right {
  flex: 1;
  padding-left: 20rpx;
}
.coupon-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.coupon-type-tag {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  display: block;
}
.coupon-time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 4rpx;
  display: block;
}
.coupon-action {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
}
.claim-btn {
  background: #FF6B35;
  color: #fff;
  padding: 12rpx 20rpx;
  border-radius: 44rpx;
  font-size: 24rpx;
}
.claimed-text {
  color: #ccc;
  font-size: 24rpx;
}

.coupon-status-tag {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 44rpx;
}
.coupon-status-tag.unused { background: #FFF3E0; color: #E65100; }
.coupon-status-tag.used { background: #E8F5E9; color: #2E7D32; }
.coupon-status-tag.expired { background: #ECEFF1; color: #90A4AE; }

.empty-state {
  text-align: center;
  padding: 80rpx;
  color: #999;
  font-size: 28rpx;
}
