<view class="container">
  <!-- 头像 -->
  <view class="card avatar-section">
    <text class="section-label">头像</text>
    <view class="avatar-picker" bindtap="chooseAvatar">
      <image wx:if="{{avatar}}" class="avatar-img" src="{{avatar}}" mode="aspectFill"></image>
      <text wx:else class="avatar-placeholder">{{nickname ? nickname[0] : '用'}}</text>
      <view class="avatar-camera">📷</view>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="card form-section">
    <text class="section-label">基本信息</text>

    <view class="form-item">
      <text class="fi-label">昵称</text>
      <input
        class="fi-input"
        placeholder="请输入昵称"
        value="{{nickname}}"
        bindinput="onNicknameInput"
        maxlength="20"
      />
    </view>

    <view class="form-item last">
      <text class="fi-label">手机号</text>
      <input
        class="fi-input"
        type="number"
        placeholder="请输入手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
        maxlength="11"
      />
      <text class="fi-hint" wx:if="{{originalPhone}}">原手机号：{{originalPhone}}</text>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="btn-primary {{changed ? '' : 'disabled'}}" bindtap="onSave">
    {{saving ? '保存中...' : '保存修改'}}
  </view>
</view>
