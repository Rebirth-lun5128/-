.login-page {
  padding: 120rpx 60rpx;
}
.login-header {
  text-align: center;
  margin-bottom: 60rpx;
}
.title {
  font-size: 44rpx;
  font-weight: bold;
  display: block;
}
.subtitle {
  font-size: 28rpx;
  color: #999;
  margin-top: 16rpx;
  display: block;
}
.form {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 40rpx;
}
.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.form-item:last-child { border-bottom: none; }
.label {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
}
.form-item input {
  font-size: 32rpx;
}
.pwd-row {
  display: flex;
  align-items: center;
}
.pwd-input {
  flex: 1;
}
.pwd-eye {
  padding: 0 16rpx;
  font-size: 36rpx;
}
.toggle {
  text-align: center;
  margin-top: 30rpx;
  color: #07C160;
  font-size: 28rpx;
}
