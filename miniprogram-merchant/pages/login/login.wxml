<view class="login-page">
  <view class="login-header">
    <text class="title">{{isRegister ? '商家注册' : '商家登录'}}</text>
    <text class="subtitle">管理您的店铺和订单</text>
  </view>

  <view class="form">
    <view class="form-item">
      <text class="label">手机号</text>
      <input type="number" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
    <view class="form-item">
      <text class="label">密码</text>
      <input type="password" placeholder="请输入密码 (开发: 123456)" value="{{password}}" bindinput="onPwdInput" />
    </view>
  </view>

  <button class="btn-primary" bindtap="doLogin">{{isRegister ? '注册' : '登录'}}</button>
  <view class="toggle" bindtap="toggleMode">
    {{isRegister ? '已有账号？去登录' : '没有账号？去注册'}}
  </view>
</view>
