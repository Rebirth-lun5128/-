/* 页面背景 */
page { background: #f5f5f5; }
.container { padding: 24rpx; }

/* 今日营收卡片 */
.total-card { text-align: center; padding: 60rpx 0; background: linear-gradient(135deg, #07C160, #05A050); color: #fff; border-radius: 16rpx; margin-bottom: 24rpx; }
.total-label { font-size: 28rpx; display: block; opacity: 0.9; }
.total-price { font-size: 72rpx; font-weight: bold; display: block; margin: 16rpx 0; }
.total-sub { font-size: 26rpx; display: block; opacity: 0.8; }

/* 通用卡片 */
.card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx; }

.section-title { font-size: 30rpx; font-weight: bold; display: block; margin-bottom: 20rpx; }

.info-row { display: flex; justify-content: space-between; align-items: center; padding: 14rpx 0; font-size: 28rpx; border-bottom: 1rpx solid #f5f5f5; }
.info-row:last-child { border-bottom: none; }
.info-row.highlight { font-weight: bold; font-size: 30rpx; border-bottom: none; }

.price-text { color: #333; }
.price-text.green { color: #07C160; }
.price-text.orange { color: #FF6B35; font-size: 32rpx; }

.divider { height: 1rpx; background: #eee; margin: 8rpx 0; }

/* 提现按钮 */
.withdraw-section { text-align: center; margin-bottom: 24rpx; }
.withdraw-btn { width: 100%; background: #FF6B35; color: #fff; border-radius: 44rpx; font-size: 32rpx; font-weight: bold; border: none; }
.withdraw-btn[disabled] { background: #ccc; color: #999; }
.withdraw-tip { font-size: 24rpx; color: #999; display: block; margin-top: 12rpx; }

/* 提现记录 */
.record-item { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.record-item:last-child { border-bottom: none; }
.record-amount { font-size: 32rpx; font-weight: bold; display: block; }
.record-period { font-size: 24rpx; color: #999; margin-top: 4rpx; }
.record-status { font-size: 26rpx; padding: 6rpx 16rpx; border-radius: 20rpx; }
.record-status.paid { background: #E8F5E9; color: #07C160; }
.record-status.pending { background: #FFF3E0; color: #FF9800; }

/* 提现弹窗 */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 100; }
.modal-box { background: #fff; border-radius: 24rpx; padding: 40rpx 32rpx; width: 580rpx; }
.modal-title { font-size: 34rpx; font-weight: bold; display: block; text-align: center; margin-bottom: 8rpx; }
.modal-sub { font-size: 26rpx; color: #999; display: block; text-align: center; margin-bottom: 28rpx; }
.modal-input { border: 2rpx solid #e0e0e0; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 32rpx; margin-bottom: 28rpx; }
.modal-btns { display: flex; gap: 20rpx; }
.modal-btn { flex: 1; border-radius: 44rpx; font-size: 30rpx; text-align: center; border: none; }
.modal-btn.cancel { background: #f5f5f5; color: #666; }
.modal-btn.confirm { background: #FF6B35; color: #fff; }

/* 空状态 */
.empty-state { display: flex; align-items: center; justify-content: center; height: 400rpx; color: #999; font-size: 28rpx; }
