.tabs { display: flex; background: #fff; border-radius: 12rpx; margin-bottom: 20rpx; }
.tab-item { flex: 1; text-align: center; padding: 24rpx 0; font-size: 26rpx; color: #666; }
.tab-item.active { color: #07C160; font-weight: bold; }

.order-card { padding: 0; overflow: hidden; }
.order-header { display: flex; justify-content: space-between; padding: 20rpx 24rpx; border-bottom: 1rpx solid #f5f5f5; }
.order-no { font-size: 26rpx; color: #999; }
.order-status { font-size: 26rpx; }
.order-items { padding: 16rpx 24rpx; font-size: 26rpx; color: #666; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.order-footer { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 24rpx; border-top: 1rpx solid #f5f5f5; }
.order-addr { font-size: 24rpx; color: #999; }
