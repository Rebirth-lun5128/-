<view class="container">
  <view class="card">
    <text class="section-title">{{isRegister ? '入驻信息' : '店铺信息'}}</text>
    <view class="form-item">
      <text class="label">店铺名称 *</text>
      <input placeholder="请输入店铺名称" value="{{form.name}}" bindinput="onInput" data-field="name" />
    </view>
    <view class="form-item">
      <text class="label">Logo URL</text>
      <input placeholder="店铺Logo图片地址" value="{{form.logo}}" bindinput="onInput" data-field="logo" />
    </view>
    <view class="form-item">
      <text class="label">Banner URL</text>
      <input placeholder="顶部横幅图片地址" value="{{form.banner}}" bindinput="onInput" data-field="banner" />
    </view>
    <view class="form-item">
      <text class="label">联系电话</text>
      <input placeholder="联系电话" value="{{form.phone}}" bindinput="onInput" data-field="phone" />
    </view>
    <view class="form-item">
      <text class="label">地址</text>
      <input placeholder="店铺地址" value="{{form.address}}" bindinput="onInput" data-field="address" />
    </view>
    <view class="form-item">
      <text class="label">分类</text>
      <input placeholder="夜市小吃/烧烤/粉面等" value="{{form.category}}" bindinput="onInput" data-field="category" />
    </view>
    <view class="form-item">
      <text class="label">夜市摊位位置 *</text>
      <input placeholder="如: XX夜市A区10号摊位" value="{{form.stall_location}}" bindinput="onInput" data-field="stall_location" />
    </view>
    <view class="form-item">
      <text class="label">摊位照片 (选填)</text>
      <input placeholder="摊位照片URL，用于平台核验" value="{{form.stall_photo}}" bindinput="onInput" data-field="stall_photo" />
    </view>
    <view class="form-item">
      <text class="label">身份证照片 (选填)</text>
      <input placeholder="身份证照片URL，用于身份核实" value="{{form.id_card_photo}}" bindinput="onInput" data-field="id_card_photo" />
    </view>
    <view class="tips" wx:if="{{isRegister}}">
      <text>⚠️ 提交后将由平台进行人工核验（现场核验或视频核验），无需营业执照。核验通过后即可营业。</text>
    </view>
  </view>

  <view class="card">
    <text class="section-title">配送设置</text>
    <view class="form-item">
      <text class="label">起送价 (元)</text>
      <input type="digit" placeholder="0" value="{{form.min_price}}" bindinput="onInput" data-field="min_price" />
    </view>
    <view class="form-item">
      <text class="label">配送费 (元)</text>
      <input type="digit" placeholder="0" value="{{form.delivery_fee}}" bindinput="onInput" data-field="delivery_fee" />
    </view>
    <view class="form-item">
      <text class="label">预计时间</text>
      <input placeholder="如: 30分钟" value="{{form.delivery_time}}" bindinput="onInput" data-field="delivery_time" />
    </view>
    <view class="form-item">
      <text class="label">公告</text>
      <input placeholder="店铺公告" value="{{form.notice}}" bindinput="onInput" data-field="notice" />
    </view>
  </view>

  <view class="card" wx:if="{{!isRegister}}">
    <text class="section-title">营业状态</text>
    <radio-group bindchange="onStatusChange">
      <label class="radio-label"><radio value="open" checked="{{form.status === 'open'}}" />营业中</label>
      <label class="radio-label"><radio value="closed" checked="{{form.status === 'closed'}}" />已打烊</label>
    </radio-group>
  </view>

  <view class="btn-primary" bindtap="onSubmit">{{isRegister ? '提交入驻' : '保存设置'}}</view>
</view>
