<view class="container">
  <view class="card">
    <text class="section-title">{{isRegister ? '入驻信息' : '店铺信息'}}</text>

    <view class="form-item" wx:if="{{isRegister}}">
      <text class="label">店铺类型 *</text>
      <picker range="{{storeTypes}}" bindchange="onStoreTypeChange" value="{{storeTypeIndex}}">
        <text>{{storeTypes[storeTypeIndex]}}</text>
      </picker>
    </view>

    <view class="form-item">
      <text class="label">店铺名称 *</text>
      <input placeholder="请输入店铺名称" value="{{form.name}}" bindinput="onInput" data-field="name" />
    </view>
    <view class="form-item">
      <text class="label">店铺Logo</text>
      <view class="upload-row">
        <image class="upload-preview" src="{{form.logo}}" mode="aspectFill" wx:if="{{form.logo}}" bindtap="onChooseImage" data-field="logo"></image>
        <view class="upload-btn" bindtap="onChooseImage" data-field="logo">
          <text>{{form.logo ? '更换' : '+ 上传'}}</text>
        </view>
      </view>
    </view>
    <view class="form-item">
      <text class="label">顶部横幅</text>
      <view class="upload-row">
        <image class="upload-preview banner-preview" src="{{form.banner}}" mode="aspectFill" wx:if="{{form.banner}}" bindtap="onChooseImage" data-field="banner"></image>
        <view class="upload-btn" bindtap="onChooseImage" data-field="banner">
          <text>{{form.banner ? '更换' : '+ 上传'}}</text>
        </view>
      </view>
    </view>
    <view class="form-item">
      <text class="label">联系电话</text>
      <input placeholder="联系电话" value="{{form.phone}}" bindinput="onInput" data-field="phone" />
    </view>
    <view class="form-item">
      <text class="label">地址</text>
      <input placeholder="店铺地址" value="{{form.address}}" bindinput="onInput" data-field="address" />
    </view>
    <view class="form-item">
      <text class="label">分类</text>
      <input placeholder="夜市小吃/烧烤/粉面等" value="{{form.category}}" bindinput="onInput" data-field="category" />
    </view>
    <view class="form-item">
      <text class="label">摊位位置</text>
      <input placeholder="如: XX夜市A区10号摊位" value="{{form.stall_location}}" bindinput="onInput" data-field="stall_location" />
    </view>
    <view class="form-item">
      <text class="label">摊位照片</text>
      <view class="upload-row">
        <image class="upload-preview" src="{{form.stall_photo}}" mode="aspectFill" wx:if="{{form.stall_photo}}" bindtap="onChooseImage" data-field="stall_photo"></image>
        <view class="upload-btn" bindtap="onChooseImage" data-field="stall_photo">
          <text>{{form.stall_photo ? '更换' : '+ 上传'}}</text>
        </view>
      </view>
    </view>
    <view class="form-item">
      <text class="label">身份证照片</text>
      <view class="upload-row">
        <image class="upload-preview" src="{{form.id_card_photo}}" mode="aspectFill" wx:if="{{form.id_card_photo}}" bindtap="onChooseImage" data-field="id_card_photo"></image>
        <view class="upload-btn" bindtap="onChooseImage" data-field="id_card_photo">
          <text>{{form.id_card_photo ? '更换' : '+ 上传'}}</text>
        </view>
      </view>
    </view>
    <view class="tips" wx:if="{{isRegister}}">
      <text>⚠️ 提交后将由分区管理员进行人工核验（现场核验或视频核验），无需营业执照。</text>
    </view>
  </view>

  <view class="card">
    <text class="section-title">配送设置</text>
    <view class="form-item">
      <text class="label">起送价 (元)</text>
      <input type="digit" placeholder="0" value="{{form.min_price}}" bindinput="onInput" data-field="min_price" />
    </view>
    <view class="form-item">
      <text class="label">预计时间</text>
      <input placeholder="如: 30分钟" value="{{form.delivery_time}}" bindinput="onInput" data-field="delivery_time" />
    </view>
    <view class="form-item">
      <text class="label">公告</text>
      <input placeholder="店铺公告" value="{{form.notice}}" bindinput="onInput" data-field="notice" />
    </view>
  </view>

  <view class="card" wx:if="{{!isRegister}}">
    <text class="section-title">营业状态</text>
    <view class="status-options">
      <view class="status-option {{form.status === 'open' ? 'active' : ''}}" bindtap="setStatus" data-status="open">
        <text class="status-icon">🟢</text>
        <text>营业中</text>
      </view>
      <view class="status-option {{form.status === 'resting' ? 'active' : ''}}" bindtap="setStatus" data-status="resting">
        <text class="status-icon">🟡</text>
        <text>休息中</text>
      </view>
      <view class="status-option {{form.status === 'closed' ? 'active' : ''}}" bindtap="setStatus" data-status="closed">
        <text class="status-icon">⚫</text>
        <text>已收摊</text>
      </view>
    </view>
  </view>

  <view class="btn-primary" bindtap="onSubmit">{{isRegister ? '提交入驻' : '保存设置'}}</view>

  <view class="btn-logout" wx:if="{{!isRegister}}" bindtap="onLogout">退出登录</view>
</view>
