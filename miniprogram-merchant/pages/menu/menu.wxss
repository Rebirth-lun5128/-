.page { display: flex; height: 100vh; }

.category-sidebar {
  width: 180rpx;
  background: #f8f8f8;
}
.cat-item {
  padding: 30rpx 16rpx;
  font-size: 26rpx;
  text-align: center;
  border-left: 4rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.cat-item.active {
  background: #fff;
  border-left-color: #07C160;
  color: #07C160;
  font-weight: bold;
}
.cat-more { color: #999; font-size: 22rpx; padding: 8rpx 12rpx; margin: -8rpx -8rpx -8rpx 0; }
.add-cat { color: #07C160; font-size: 24rpx; }
.empty-cat { padding: 40rpx 16rpx; font-size: 24rpx; color: #999; text-align: center; }
.empty-items { padding: 60rpx 24rpx; font-size: 26rpx; color: #999; text-align: center; }

.items-panel {
  flex: 1;
  background: #fff;
  padding: 16rpx;
}
.menu-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.menu-item image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  margin-right: 16rpx;
  background: #eee;
}
.item-info { flex: 1; }
.item-name { font-size: 28rpx; font-weight: bold; }
.item-desc { font-size: 24rpx; color: #999; display: block; margin-top: 4rpx; }
.item-meta { display: flex; align-items: center; margin-top: 8rpx; gap: 16rpx; }
.item-actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16rpx;
}
.item-actions text {
  font-size: 22rpx;
  color: #07C160;
  padding: 6rpx 16rpx;
  border: 1rpx solid #07C160;
  border-radius: 6rpx;
  text-align: center;
}

.add-item-btn {
  text-align: center;
  padding: 30rpx;
  color: #07C160;
  font-size: 28rpx;
  border: 2rpx dashed #07C160;
  border-radius: 12rpx;
  margin-top: 20rpx;
}

/* 编辑/添加分类弹窗 */
.edit-modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 999;
  display: flex; align-items: center; justify-content: center;
}
.edit-modal-box {
  width: 560rpx; background: #fff; border-radius: 16rpx;
  padding: 40rpx 32rpx 24rpx;
}
.edit-modal-title { font-size: 32rpx; font-weight: bold; display: block; margin-bottom: 24rpx; text-align: center; }
.edit-modal-input {
  border: 1rpx solid #ddd; border-radius: 10rpx; padding: 16rpx 20rpx;
  font-size: 28rpx; margin-bottom: 28rpx;
}
.edit-modal-btns { display: flex; gap: 20rpx; }
.edit-modal-btn { flex: 1; text-align: center; border-radius: 36rpx; font-size: 28rpx; padding: 16rpx 0; border: none; }
.edit-modal-btn.cancel { background: #f5f5f5; color: #666; }
.edit-modal-btn.confirm { background: #07C160; color: #fff; }
