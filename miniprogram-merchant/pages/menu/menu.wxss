.page { display: flex; height: 100vh; }

.category-sidebar {
  width: 180rpx;
  background: #f8f8f8;
}
.cat-item {
  padding: 30rpx 16rpx;
  font-size: 26rpx;
  text-align: center;
  border-left: 4rpx solid transparent;
}
.cat-item.active {
  background: #fff;
  border-left-color: #07C160;
  color: #07C160;
  font-weight: bold;
}
.add-cat { color: #07C160; font-size: 24rpx; }
.empty-cat { padding: 40rpx 16rpx; font-size: 24rpx; color: #999; text-align: center; }

.items-panel {
  flex: 1;
  background: #fff;
  padding: 16rpx;
}
.menu-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.menu-item image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  margin-right: 16rpx;
  background: #eee;
}
.item-info { flex: 1; }
.item-name { font-size: 28rpx; font-weight: bold; }
.item-desc { font-size: 24rpx; color: #999; display: block; margin-top: 4rpx; }
.item-meta { display: flex; align-items: center; margin-top: 8rpx; gap: 16rpx; }
.item-actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16rpx;
}
.item-actions text {
  font-size: 22rpx;
  color: #07C160;
  padding: 6rpx 16rpx;
  border: 1rpx solid #07C160;
  border-radius: 6rpx;
  text-align: center;
}

.add-item-btn {
  text-align: center;
  padding: 30rpx;
  color: #07C160;
  font-size: 28rpx;
  border: 2rpx dashed #07C160;
  border-radius: 12rpx;
  margin-top: 20rpx;
}
