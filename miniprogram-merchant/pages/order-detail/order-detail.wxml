<view class="container" wx:if="{{order}}">
  <view class="card">
    <view class="order-no">订单号: {{order.order_no}}</view>
    <view class="order-status" style="color: #FF6B35">{{order.statusText}}</view>
  </view>

  <view class="card">
    <text class="section-title">收货信息</text>
    <text>{{order.address_snapshot.contact_name}} {{order.address_snapshot.contact_phone}}</text>
    <text class="addr">{{order.address_snapshot.province}}{{order.address_snapshot.city}}{{order.address_snapshot.district}}{{order.address_snapshot.detail}}</text>
  </view>

  <view class="card">
    <text class="section-title">菜品清单</text>
    <view class="item" wx:for="{{order.items}}" wx:key="id">
      <text>{{item.name}} x{{item.quantity}}</text>
      <text class="price">{{item.price * item.quantity}}</text>
    </view>
    <view class="total-row">
      <text>合计</text>
      <text class="price">{{order.total_price}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{order.remark}}">
    <text class="section-title">备注</text>
    <text>{{order.remark}}</text>
  </view>

  <!-- 时间线 -->
  <view class="card" wx:if="{{timeline.length > 0}}">
    <text class="section-title">订单轨迹</text>
    <view class="timeline-item" wx:for="{{timeline}}" wx:key="id">
      <view class="dot"></view>
      <view class="timeline-content">
        <text>{{item.description}}</text>
        <text class="time">{{item.created_at}}</text>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions" wx:if="{{order.status === 'pending_accept'}}">
    <view class="btn-outline" bindtap="rejectOrder">拒单</view>
    <view class="btn-primary" bindtap="acceptOrder">接单</view>
  </view>
  <view class="actions" wx:if="{{order.status === 'preparing'}}">
    <view class="btn-primary" bindtap="markReady">确认出餐</view>
  </view>
</view>
