.status-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}
.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ccc;
  margin-right: 12rpx;
}
.status-dot.online {
  background: #07C160;
}
.go-shop {
  margin-left: auto;
  color: #07C160;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.stat-card {
  width: calc(50% - 10rpx);
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
}
.stat-num {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
}
.stat-num.warn { color: #FF6B35; }
.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
}
.quick-actions {
  display: flex;
}
.quick-item {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
}
.quick-icon {
  display: block;
  font-size: 50rpx;
  margin-bottom: 10rpx;
}
