.form-item { padding: 24rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.form-item:last-child { border-bottom: none; }
.label { display: block; font-size: 26rpx; color: #999; margin-bottom: 12rpx; }
.form-item input, .form-item picker { font-size: 30rpx; }
.picker-val { font-size: 30rpx; color: #333; }
.field-tip { font-size: 22rpx; color: #bbb; margin-top: 6rpx; display: block; }
.section-title { font-size: 28rpx; font-weight: bold; display: block; margin-bottom: 8rpx; }

.upload-row { display: flex; align-items: center; gap: 16rpx; }
.upload-preview { width: 140rpx; height: 140rpx; border-radius: 12rpx; border: 1rpx solid #eee; }
.upload-btn {
  width: 140rpx; height: 140rpx; border: 2rpx dashed #ddd; border-radius: 12rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.upload-plus { font-size: 48rpx; color: #ccc; line-height: 1; }
.upload-text { font-size: 22rpx; color: #999; margin-top: 4rpx; }

.switch-row { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0; }
.switch-label { font-size: 28rpx; }

.stock-presets { display: flex; gap: 12rpx; margin-bottom: 12rpx; }
.stock-tag {
  padding: 8rpx 20rpx; border-radius: 8rpx; font-size: 26rpx;
  background: #f5f5f5; color: #666;
}
.stock-tag.active { background: #FFF9F5; color: #FF6B35; border: 1rpx solid #FF6B35; }
.stock-input { margin-top: 4rpx; }
