page { background: #f5f5f5; }
.container { padding: 24rpx; }

.header { margin-bottom: 24rpx; }
.title { font-size: 34rpx; font-weight: bold; display: block; }
.sub { font-size: 24rpx; color: #999; margin-top: 6rpx; }

.empty { text-align: center; padding: 120rpx 0; color: #999; font-size: 28rpx; }

.mod-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.mod-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.mod-type { font-size: 28rpx; font-weight: bold; padding: 4rpx 16rpx; border-radius: 8rpx; }
.mod-type.cancel { background: #FFEBEE; color: #E53935; }
.mod-type.address_change { background: #E3F2FD; color: #1565C0; }
.mod-type.refund { background: #FFF3E0; color: #EF6C00; }
.mod-type.other { background: #F3E5F5; color: #7B1FA2; }

.mod-status { font-size: 24rpx; padding: 4rpx 12rpx; border-radius: 12rpx; }
.mod-status.pending_review { background: #FFF3E0; color: #FF9800; }
.mod-status.approved { background: #E8F5E9; color: #07C160; }
.mod-status.rejected { background: #FFEBEE; color: #E53935; }

.mod-order { font-size: 24rpx; color: #666; display: block; margin-bottom: 4rpx; }
.mod-reason { font-size: 26rpx; color: #333; display: block; margin-bottom: 4rpx; }
.mod-amount { font-size: 26rpx; color: #FF6B35; display: block; margin-bottom: 4rpx; }
.mod-time { font-size: 22rpx; color: #999; display: block; }

.mod-actions { display: flex; gap: 20rpx; margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #f0f0f0; }
.mod-btn { flex: 1; text-align: center; border-radius: 36rpx; font-size: 28rpx; display: flex; align-items: center; justify-content: center; border: none; }
.mod-btn.reject { background: #f5f5f5; color: #666; }
.mod-btn.approve { background: #07C160; color: #fff; }

.mod-result { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f0f0f0; font-size: 24rpx; color: #999; }

.load-more { text-align: center; padding: 30rpx; color: #999; font-size: 24rpx; }

/* 拒绝原因弹窗 */
.edit-modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 999;
  display: flex; align-items: center; justify-content: center;
}
.edit-modal-box {
  width: 560rpx; background: #fff; border-radius: 16rpx;
  padding: 40rpx 32rpx 24rpx;
}
.edit-modal-title { font-size: 32rpx; font-weight: bold; display: block; margin-bottom: 24rpx; text-align: center; }
.edit-modal-input {
  border: 1rpx solid #ddd; border-radius: 10rpx; padding: 16rpx 20rpx;
  font-size: 28rpx; margin-bottom: 28rpx;
}
.edit-modal-btns { display: flex; gap: 20rpx; }
.edit-modal-btn { flex: 1; text-align: center; border-radius: 36rpx; font-size: 28rpx; padding: 16rpx 0; border: none; }
.edit-modal-btn.cancel { background: #f5f5f5; color: #666; }
.edit-modal-btn.confirm { background: #07C160; color: #fff; }
