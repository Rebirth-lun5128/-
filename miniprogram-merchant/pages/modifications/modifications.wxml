<view class="container">
  <view class="header">
    <text class="title">订单修改审核</text>
    <text class="sub">处理用户的退单、改地址等申请</text>
  </view>

  <view wx:if="{{items.length === 0 && !loading}}" class="empty">
    <text>暂无待审核申请</text>
  </view>

  <view class="mod-card" wx:for="{{items}}" wx:key="id">
    <view class="mod-header">
      <text class="mod-type {{item.type}}">{{item.typeText}}</text>
      <text class="mod-status {{item.status}}">
        {{item.status === 'pending_review' ? '待审核' : item.status === 'approved' ? '已同意' : '已拒绝'}}
      </text>
    </view>
    <text class="mod-order">订单号: {{item.order_no}}</text>
    <text class="mod-reason" wx:if="{{item.reason}}">原因: {{item.reason}}</text>
    <text class="mod-amount" wx:if="{{item.items_total > 0}}">金额: ¥{{item.items_total}}</text>
    <text class="mod-time">{{item.created_at}}</text>

    <view class="mod-actions" wx:if="{{item.status === 'pending_review'}}">
      <button class="mod-btn reject" bindtap="onReject" data-id="{{item.id}}">拒绝</button>
      <button class="mod-btn approve" bindtap="onApprove" data-id="{{item.id}}">同意</button>
    </view>

    <view class="mod-result" wx:elif="{{item.status !== 'pending_review'}}">
      <text>{{item.review_comment || '已处理'}}</text>
    </view>
  </view>

  <view class="load-more" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 拒绝原因弹窗 -->
  <view class="edit-modal-mask" wx:if="{{showRejectModal}}" catchtap="onRejectModalCancel">
    <view class="edit-modal-box" catchtap="">
      <text class="edit-modal-title">拒绝申请</text>
      <input class="edit-modal-input" value="{{rejectModalValue}}" placeholder="请输入拒绝原因（选填）" bindinput="onRejectModalInput" focus />
      <view class="edit-modal-btns">
        <button class="edit-modal-btn cancel" bindtap="onRejectModalCancel">取消</button>
        <button class="edit-modal-btn confirm" bindtap="onRejectModalConfirm">确定</button>
      </view>
    </view>
  </view>
</view>
