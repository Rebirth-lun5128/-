page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: #333;
  background: #f5f5f5;
}

.container {
  padding: 20rpx;
}

.btn-primary {
  background: #07C160;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  padding: 24rpx 0;
  text-align: center;
}

.btn-sm {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.price {
  color: #FF6B35;
  font-weight: bold;
}
.price::before {
  content: '¥';
  font-size: 24rpx;
}

.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
}

.tag-green {
  background: #E8F8EE;
  color: #07C160;
}

.tag-orange {
  background: #FFF3ED;
  color: #FF6B35;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #999;
}
