.page { padding: 24rpx; }

.card {
  background: #fff; border-radius: 20rpx; padding: 28rpx;
  margin-bottom: 24rpx; box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04);
}

.section-title { font-size: 30rpx; font-weight: 700; color: #333; display: block; margin-bottom: 6rpx; }
.section-hint { font-size: 24rpx; color: #999; display: block; margin-bottom: 20rpx; }

/* 阶梯行 */
.tier-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.tier-row.header { padding-bottom: 12rpx; border-bottom: 1rpx solid #eee; }
.tier-cell { font-size: 24rpx; color: #999; font-weight: 600; text-align: center; }
.tier-input {
  background: #f8f9fc; border-radius: 12rpx; padding: 14rpx 12rpx;
  font-size: 26rpx; color: #333; text-align: center; box-sizing: border-box;
}
.tier-del {
  font-size: 28rpx; color: #E53935; padding: 12rpx; font-weight: 700;
}

/* 按钮 */
.btn-row { display: flex; gap: 16rpx; margin-top: 16rpx; }
.btn-outline {
  flex: 1; text-align: center; padding: 20rpx 0; border-radius: 44rpx;
  font-size: 26rpx; font-weight: 600; color: #6C5CE7; background: #F4F2FF;
  border: 2rpx dashed #c4b5fd;
}
.btn-save {
  flex: 1; text-align: center; padding: 20rpx 0; border-radius: 44rpx;
  font-size: 26rpx; font-weight: 600; color: #fff;
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
}
.btn-save.disabled { opacity: 0.6; }

/* 预览 */
.preview-row { display: flex; align-items: center; }
.preview-label { font-size: 26rpx; color: #666; margin-right: 8rpx; }
.preview-input {
  background: #f8f9fc; border-radius: 14rpx; padding: 16rpx 20rpx;
  font-size: 28rpx; color: #333; width: 180rpx; box-sizing: border-box;
}
.preview-result {
  display: block; margin-top: 16rpx; font-size: 26rpx; color: #333;
  background: #f8f9fc; padding: 20rpx; border-radius: 14rpx;
  font-weight: 600; text-align: center;
}
