/* 详情头部 */
.detail-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.detail-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #333;
}

/* 信息网格 */
.detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.detail-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 16rpx;
  background: #f8f9fc;
  border-radius: 14rpx;
}
.di-label {
  font-size: 22rpx;
  color: #999;
}
.di-val {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}
.edit-type {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}

/* 抽成设置行 */
.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.setting-row:last-child { border-bottom: none; }
.setting-label {
  font-size: 28rpx;
  color: #666;
}
.setting-val {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 22rpx;
  border-radius: 28rpx;
  background: #f5f3ff;
  border: 2rpx dashed #c4b5fd;
}
.setting-val:active {
  background: #ede7ff;
  border-color: #6C5CE7;
}
.setting-num {
  font-size: 30rpx;
  font-weight: 700;
  color: #6C5CE7;
}
.setting-hint {
  font-size: 22rpx;
  color: #b4a5e0;
}

/* 编辑模式 */
.edit-inline {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.edit-input {
  width: 100rpx;
  background: #f8f9fc;
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #6C5CE7;
  text-align: center;
  border: 2rpx solid #6C5CE7;
}
.edit-unit {
  font-size: 24rpx;
  color: #999;
}
.edit-btn {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 600;
}
.edit-btn.save {
  background: #6C5CE7;
  color: #fff;
}
.edit-btn.cancel {
  background: #f5f5f5;
  color: #999;
}

/* 弹窗（复用 products 页样式） */
.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 200; }
.dialog {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff; border-radius: 24rpx 24rpx 0 0; z-index: 201;
  max-height: 80vh; display: flex; flex-direction: column;
}
.dialog-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 28rpx; border-bottom: 1rpx solid #f0f0f0;
  font-size: 30rpx; font-weight: 700; color: #333;
}
.dialog-close { font-size: 24rpx; color: #999; padding: 8rpx; }
.dialog-body { flex: 1; padding: 24rpx 28rpx; overflow-y: auto; }
.dialog-footer {
  display: flex; gap: 20rpx; padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
}

/* 表单 */
.form-item { margin-bottom: 22rpx; }
.fi-label { display: block; font-size: 26rpx; color: #666; margin-bottom: 10rpx; }
.form-picker {
  width: 100%; background: #f8f9fc; border-radius: 14rpx;
  padding: 20rpx 22rpx; font-size: 28rpx; color: #333; box-sizing: border-box;
}

/* 多选列表 */
.checkbox-list { background: #f8f9fc; border-radius: 14rpx; overflow: hidden; }
.checkbox-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 18rpx 22rpx; border-bottom: 1rpx solid #f0f0f0; font-size: 26rpx; color: #333;
}
.checkbox-item:last-child { border-bottom: none; }
.checkbox-item.checked { background: #F4F2FF; color: #6C5CE7; font-weight: 600; }
.check-mark { color: #6C5CE7; font-weight: 700; font-size: 26rpx; }

/* 弹窗按钮 */
.btn-cancel, .btn-save {
  flex: 1; text-align: center; padding: 22rpx 0; border-radius: 44rpx;
  font-size: 28rpx; font-weight: 600;
}
.btn-cancel { background: #f5f5f5; color: #666; }
.btn-save { background: linear-gradient(135deg, #6C5CE7, #A29BFE); color: #fff; }

/* 二维码 */
.qr-section {
  display: flex; flex-direction: column; align-items: center; padding: 16rpx 0;
}
.qr-img {
  width: 360rpx; height: 360rpx; border: 12rpx solid #fff;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.1); border-radius: 16rpx;
}
.mt-2 { margin-top: 16rpx; }
