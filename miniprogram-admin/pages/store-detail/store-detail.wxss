/* 详情头部 */
.detail-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.detail-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #333;
}

/* 信息网格 */
.detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.detail-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 16rpx;
  background: #f8f9fc;
  border-radius: 14rpx;
}
.di-label {
  font-size: 22rpx;
  color: #999;
}
.di-val {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

/* 抽成设置行 */
.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.setting-row:last-child { border-bottom: none; }
.setting-label {
  font-size: 28rpx;
  color: #666;
}
.setting-val {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 22rpx;
  border-radius: 28rpx;
  background: #f5f3ff;
  border: 2rpx dashed #c4b5fd;
}
.setting-val:active {
  background: #ede7ff;
  border-color: #6C5CE7;
}
.setting-num {
  font-size: 30rpx;
  font-weight: 700;
  color: #6C5CE7;
}
.setting-hint {
  font-size: 22rpx;
  color: #b4a5e0;
}

/* 编辑模式 */
.edit-inline {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.edit-input {
  width: 100rpx;
  background: #f8f9fc;
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #6C5CE7;
  text-align: center;
  border: 2rpx solid #6C5CE7;
}
.edit-unit {
  font-size: 24rpx;
  color: #999;
}
.edit-btn {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 600;
}
.edit-btn.save {
  background: #6C5CE7;
  color: #fff;
}
.edit-btn.cancel {
  background: #f5f5f5;
  color: #999;
}
