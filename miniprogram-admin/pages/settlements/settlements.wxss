.container { padding: 14rpx 20rpx; }

/* 筛选器 */
.filters { background: #fff; border-radius: 16rpx; padding: 16rpx 20rpx; margin-bottom: 16rpx; }
.filter-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 10rpx; }
.filter-row:last-child { margin-bottom: 0; }
.filter-label { font-size: 26rpx; color: #999; min-width: 60rpx; }
.filter-item { font-size: 24rpx; padding: 8rpx 22rpx; border-radius: 20rpx; color: #666; background: #f5f5f5; }
.filter-item.active { color: #fff; background: #6C5CE7; }

.empty-state { text-align: center; padding: 120rpx 0; color: #999; }

/* 结算卡片 */
.settle-card { margin-bottom: 16rpx; }
.settle-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14rpx; }
.settle-head-left { display: flex; align-items: center; gap: 12rpx; }
.settle-type { font-size: 26rpx; font-weight: bold; }
.settle-type.rider { color: #E17055; }
.settle-type.store { color: #00B894; }
.settle-status { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 20rpx; }
.settle-status.pending { background: #FFF3E0; color: #E17055; }
.settle-status.paid { background: #E8F5E9; color: #00B894; }
.settle-id { font-size: 22rpx; color: #ccc; }

.settle-body { border-top: 1rpx solid #f5f5f5; padding-top: 14rpx; }
.info-row { display: flex; justify-content: space-between; padding: 8rpx 0; }
.info-row.highlight { background: #f9f9ff; border-radius: 8rpx; padding: 8rpx 12rpx; margin: 4rpx -12rpx; }
.ir-label { font-size: 26rpx; color: #999; }
.ir-val { font-size: 26rpx; color: #333; }
.ir-val.price { font-weight: bold; color: #6C5CE7; }
.ir-val.fee { color: #E17055; }
.ir-val.green { font-weight: bold; color: #00B894; }

.settle-foot { margin-top: 14rpx; }
.btn-success.btn-block { width: 100%; text-align: center; padding: 18rpx 0; background: #00B894; color: #fff; border-radius: 40rpx; font-size: 28rpx; font-weight: bold; }
