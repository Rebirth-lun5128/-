.container { padding-bottom: 120rpx; }

/* 店铺头 */
.store-header { padding: 20rpx 28rpx; }
.store-name { font-size: 30rpx; font-weight: 700; color: #333; }

/* 分类标签 */
.cat-scroll { white-space: nowrap; padding: 0 28rpx 16rpx; }
.cat-tab {
  display: inline-block;
  padding: 10rpx 22rpx;
  margin-right: 12rpx;
  border-radius: 44rpx;
  font-size: 24rpx;
  background: #f5f5f5;
  color: #666;
}
.cat-tab.active { background: #6C5CE7; color: #fff; font-weight: 600; }
.cat-tab.cat-add { border: 2rpx dashed #ccc; background: transparent; color: #999; }
.cat-edit, .cat-del { font-size: 20rpx; margin-left: 4rpx; opacity: 0.5; }
.cat-tab.active .cat-edit,
.cat-tab.active .cat-del { opacity: 0.7; }

/* 商品卡片 */
.prod-list { padding: 0 24rpx; }
.prod-card {
  display: flex; background: #fff; border-radius: 16rpx;
  margin-bottom: 16rpx; padding: 16rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}
.prod-img { width: 140rpx; height: 140rpx; border-radius: 12rpx; flex-shrink: 0; background: #f0f0f0; }
.prod-body { flex: 1; margin-left: 16rpx; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; }
.prod-top { display: flex; justify-content: space-between; align-items: center; }
.prod-name { font-size: 28rpx; font-weight: 600; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
.prod-status { font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 12rpx; flex-shrink: 0; margin-left: 12rpx; }
.prod-status.on { background: #E8F5E9; color: #2E7D32; }
.prod-status.off { background: #f5f5f5; color: #999; }

.prod-meta { display: flex; align-items: center; gap: 10rpx; font-size: 24rpx; }
.prod-price { color: #E17055; font-weight: 700; font-size: 28rpx; }
.prod-orig { color: #ccc; font-size: 22rpx; text-decoration: line-through; }
.prod-stock { color: #999; font-size: 22rpx; }

.prod-actions { display: flex; gap: 12rpx; }
.action-btn { font-size: 22rpx; padding: 6rpx 18rpx; border-radius: 12rpx; }
.action-btn.edit { background: #F4F2FF; color: #6C5CE7; }
.action-btn.del { background: #FFF0ED; color: #E17055; }

.empty-hint { text-align: center; padding: 60rpx 0; color: #bbb; font-size: 26rpx; }

/* 底部 */
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 16rpx 28rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.04); }
.add-btn { background: linear-gradient(135deg, #6C5CE7, #A29BFE); color: #fff; text-align: center; padding: 22rpx 0; border-radius: 44rpx; font-size: 28rpx; font-weight: 600; }

/* ====== 弹窗 ====== */
.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 200; }
.dialog {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff; border-radius: 24rpx 24rpx 0 0; z-index: 201;
  max-height: 80vh; display: flex; flex-direction: column;
}
.dialog.small { max-height: none; }
.dialog-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 28rpx; border-bottom: 1rpx solid #f0f0f0;
  font-size: 30rpx; font-weight: 700; color: #333;
}
.dialog-close { font-size: 24rpx; color: #999; padding: 8rpx; }
.dialog-body { flex: 1; padding: 24rpx 28rpx; overflow-y: auto; }
.dialog-footer {
  display: flex; gap: 20rpx; padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
}

.form-item { margin-bottom: 20rpx; }
.form-item.half { width: 48%; }
.form-label { display: block; font-size: 24rpx; color: #999; margin-bottom: 8rpx; }
.form-input {
  width: 100%; height: 76rpx; background: #f8f9fc; border-radius: 12rpx;
  padding: 0 20rpx; font-size: 26rpx; box-sizing: border-box;
}
.form-textarea {
  width: 100%; height: 120rpx; background: #f8f9fc; border-radius: 12rpx;
  padding: 16rpx 20rpx; font-size: 26rpx; box-sizing: border-box;
}
.form-row { display: flex; gap: 4%; }
.form-picker {
  width: 100%; height: 76rpx; background: #f8f9fc; border-radius: 12rpx;
  padding: 0 20rpx; font-size: 26rpx; box-sizing: border-box;
  display: flex; align-items: center; color: #333;
}

/* 图片上传 */
.img-picker { margin-top: 8rpx; }
.img-preview { width: 140rpx; height: 140rpx; border-radius: 12rpx; background: #f0f0f0; }
.img-placeholder {
  width: 140rpx; height: 140rpx; border-radius: 12rpx;
  border: 2rpx dashed #ccc; display: flex; align-items: center;
  justify-content: center; font-size: 22rpx; color: #999;
}

.btn-cancel, .btn-save {
  flex: 1; text-align: center; padding: 22rpx 0; border-radius: 44rpx;
  font-size: 28rpx; font-weight: 600;
}
.btn-cancel { background: #f5f5f5; color: #666; }
.btn-save { background: linear-gradient(135deg, #6C5CE7, #A29BFE); color: #fff; }
