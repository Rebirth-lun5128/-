/* 搜索框 */
.search-box {
  margin-bottom: 20rpx;
}
.search-input {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}

/* 商家卡片 */
.store-card { padding-bottom: 20rpx; }
.store-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}
.store-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.store-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}
.store-cat {
  font-size: 24rpx;
  color: #999;
}
.store-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

/* 抽成比例行 */
.commission-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
}
.commission-label {
  font-size: 26rpx;
  color: #999;
}
.commission-val {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  background: #f5f3ff;
  border: 2rpx dashed #c4b5fd;
}
.commission-val:active {
  background: #ede7ff;
  border-color: #6C5CE7;
}
.commission-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #6C5CE7;
}
.commission-hint {
  font-size: 20rpx;
  color: #b4a5e0;
}

/* 编辑模式 */
.commission-edit {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.rate-input {
  width: 100rpx;
  background: #f8f9fc;
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #6C5CE7;
  text-align: center;
  border: 2rpx solid #6C5CE7;
}
.edit-unit {
  font-size: 24rpx;
  color: #999;
}
.edit-btn {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 600;
}
.edit-btn.save {
  background: #6C5CE7;
  color: #fff;
}
.edit-btn.cancel {
  background: #f5f5f5;
  color: #999;
}

/* 卡片底部 */
.store-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}
.store-time {
  font-size: 24rpx;
  color: #bbb;
}
.store-detail-link {
  font-size: 26rpx;
  color: #6C5CE7;
  font-weight: 600;
}
