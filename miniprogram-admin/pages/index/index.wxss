/* ====== 新订单提醒条 ====== */
.new-order-bar {
  background: linear-gradient(135deg, #E17055, #d63031);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  animation: pulse-bar 1.5s ease-in-out infinite;
}
@keyframes pulse-bar {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.85; }
}
.no-dot {
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
  background: #fff;
  animation: blink-dot 0.8s ease-in-out infinite;
}
@keyframes blink-dot {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}
.no-text {
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  flex: 1;
}

/* ====== 欢迎横幅 ====== */
.welcome-banner {
  background: linear-gradient(135deg, #1a1940, #2d2b6b, #3d3b9b);
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(26,25,64,0.3);
}
.welcome-text { display: flex; flex-direction: column; }
.welcome-hi {
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
}
.welcome-sub {
  color: rgba(255,255,255,0.5);
  font-size: 24rpx;
  margin-top: 6rpx;
}
.welcome-quick { display: flex; flex-direction: column; gap: 6rpx; }
.welcome-stat {
  color: rgba(255,255,255,0.7);
  font-size: 22rpx;
  text-align: right;
}

/* ====== KPI 卡片网格 ====== */
.kpi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.kpi-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  position: relative;
  overflow: hidden;
}
.kpi-card::after {
  content: '';
  position: absolute;
  width: 80rpx; height: 80rpx;
  border-radius: 50%;
  background: var(--bg);
  right: -20rpx; bottom: -20rpx;
  opacity: 0.15;
}
.kpi-icon { font-size: 36rpx; margin-bottom: 8rpx; }
.kpi-value {
  font-size: 36rpx;
  font-weight: 800;
  color: #2d3436;
  line-height: 1.2;
}
.kpi-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.kpi-arrow {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  background: rgba(0,0,0,0.08);
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.kpi-hover {
  opacity: 0.85;
  transform: scale(0.97);
  transition: all 0.15s ease;
}

/* ====== 访问量卡片 ====== */
.visits-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 20rpx;
}
.visits-card {
  flex: 1;
  background: #fff;
  border-radius: 18rpx;
  padding: 20rpx 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.03);
}
.visits-num {
  font-size: 32rpx;
  font-weight: 800;
}
.visits-label {
  font-size: 20rpx;
  color: #bbb;
  margin-top: 4rpx;
}
.visits-card.today .visits-num { color: #6C5CE7; }
.visits-card.yesterday .visits-num { color: #636e72; }
.visits-card.total .visits-num { color: #00B894; }

/* ====== 次要指标 ====== */
.sub-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.sub-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.sub-card-top {
  display: flex;
  flex-direction: column;
  margin-bottom: 12rpx;
}
.sub-num {
  font-size: 38rpx;
  font-weight: 800;
}
.sub-num.warn { color: #E17055; }
.sub-num.danger { color: #d63031; }
.sub-num.info { color: #6C5CE7; }
.sub-num.green { color: #00B894; }
.sub-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 2rpx;
}
.sub-link {
  font-size: 24rpx;
  color: #6C5CE7;
  font-weight: 600;
}
.sub-rate {
  font-size: 22rpx;
  color: #bbb;
}

/* ====== 趋势图表 ====== */
.chart-card { padding-bottom: 12rpx; }
.chart-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 260rpx;
  padding-top: 20rpx;
}
.chart-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  justify-content: flex-end;
}
.bar-count {
  font-size: 20rpx;
  color: #999;
  margin-bottom: 6rpx;
  font-weight: 600;
}
.bar-track {
  width: 40rpx;
  height: 200rpx;
  background: #f0f0f5;
  border-radius: 10rpx 10rpx 0 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
}
.bar-fill {
  width: 100%;
  border-radius: 10rpx 10rpx 0 0;
  background: linear-gradient(180deg, #A29BFE, #6C5CE7);
  min-height: 6rpx;
  transition: height 0.6s ease;
}
.bar-label {
  font-size: 20rpx;
  color: #bbb;
  margin-top: 8rpx;
}

/* ====== 快捷操作 ====== */
.quick-section {
  margin-bottom: 20rpx;
}
.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 16rpx;
}
.quick-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.quick-item:active {
  background: #f8f7ff;
}
.quick-icon { font-size: 36rpx; }
.quick-txt { font-size: 22rpx; color: #666; font-weight: 500; }
.sub-hover { opacity: 0.8; transform: scale(0.97); }
.quick-hover { opacity: 0.7; }

/* ====== 配送模式卡片 ====== */
.delivery-card { margin-bottom: 28rpx; }
.delivery-hdr {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 16rpx;
}
.delivery-title { font-size: 28rpx; font-weight: 700; color: #333; }
.delivery-sub { font-size: 22rpx; color: #999; margin-left: 12rpx; }

/* 配送中 */
.active-delivery { }
.ad-banner {
  display: flex; align-items: center; gap: 14rpx;
  background: linear-gradient(135deg, #FFF3ED, #FFE8D6);
  border-radius: 16rpx; padding: 20rpx 22rpx; margin-bottom: 16rpx;
}
.ad-label { font-size: 24rpx; font-weight: 700; color: #E17055; }
.ad-order-no { font-size: 24rpx; color: #333; font-weight: 600; }
.ad-info { font-size: 22rpx; color: #999; }
.ad-actions { display: flex; justify-content: flex-end; }
.ad-btn {
  padding: 16rpx 40rpx; border-radius: 40rpx; font-size: 26rpx; font-weight: 700;
}
.ad-btn.deliver { background: #00B894; color: #fff; }

/* 待接单 */
.pending-section { margin-top: 10rpx; }
.pending-title { font-size: 24rpx; color: #999; margin-bottom: 10rpx; display: block; }
.pending-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 18rpx 0; border-bottom: 1rpx solid #f5f5f5;
}
.pending-item:last-child { border-bottom: none; }
.pi-info { display: flex; gap: 16rpx; align-items: center; }
.pi-no { font-size: 26rpx; color: #333; font-weight: 600; }
.pi-detail { font-size: 22rpx; color: #999; }
.pi-price { font-size: 26rpx; color: #E17055; font-weight: 700; }
.pi-accept {
  padding: 12rpx 28rpx; border-radius: 30rpx;
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
  color: #fff; font-size: 24rpx; font-weight: 600;
}
.pending-empty { text-align: center; padding: 20rpx 0; color: #ccc; font-size: 24rpx; }

/* 收入概览 */
.delivery-stats {
  display: flex; gap: 20rpx; margin-top: 20rpx;
  padding-top: 16rpx; border-top: 1rpx solid #f0f0f0;
}
.ds-item { display: flex; flex-direction: column; gap: 4rpx; }
.ds-val { font-size: 28rpx; font-weight: 700; color: #6C5CE7; }
.ds-label { font-size: 20rpx; color: #bbb; }
.ds-withdraw {
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  align-self: center;
}

/* 遮罩 */
.mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4); z-index: 100;
}

/* 提现弹窗 */
.withdraw-dialog {
  position: fixed;
  left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  width: 560rpx;
  z-index: 101;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.15);
}
.wd-title { font-size: 30rpx; font-weight: 700; color: #333; display: block; }
.wd-balance { font-size: 24rpx; color: #666; display: block; margin-top: 8rpx; }
.wd-input-wrap {
  display: flex; align-items: center; gap: 8rpx;
  background: #f5f6fa; border-radius: 12rpx;
  padding: 16rpx 24rpx; margin-top: 24rpx;
}
.wd-yuan { font-size: 32rpx; font-weight: 700; color: #333; }
.wd-input { flex: 1; font-size: 32rpx; font-weight: 700; color: #333; }
.wd-hint { font-size: 22rpx; color: #bbb; display: block; margin-top: 10rpx; }
.wd-btns { display: flex; gap: 16rpx; margin-top: 28rpx; }
.wd-btn { flex: 1; padding: 20rpx 0; border-radius: 40rpx; font-size: 28rpx; font-weight: 600; text-align: center; border: none; }
.wd-btn.cancel { background: #f5f5f5; color: #666; }
.wd-btn.confirm { background: linear-gradient(135deg, #6C5CE7, #A29BFE); color: #fff; }
.wd-btn.confirm[disabled] { opacity: 0.5; }

/* ====== 配送记录 / 提现记录 ====== */
.delivery-section-sub {
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #f0f0f0;
}
.dss-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16rpx 0;
}
.dss-title { font-size: 24rpx; font-weight: 600; color: #666; }
.dss-arrow { font-size: 20rpx; color: #bbb; }
.dss-item {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}
.dss-item:last-child { border-bottom: none; }
.dss-row {
  display: flex; justify-content: space-between; align-items: center;
}
.dss-order-no { font-size: 26rpx; color: #333; font-weight: 600; }
.dss-amount { font-size: 28rpx; font-weight: 700; color: #E17055; }
.dss-status {
  font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 16rpx;
  background: #f0f0f0; color: #999;
}
.dss-status.completed { background: #E8F8EE; color: #00B894; }
.dss-status.partial { background: #FFF8E8; color: #E17055; }
.dss-status.delivering { background: #EDE7FF; color: #6C5CE7; }
.dss-status.pending { background: #FFF3E0; color: #E17055; }
.dss-status.paid { background: #E8F8EE; color: #00B894; }
.dss-row.sub { font-size: 22rpx; color: #999; margin-top: 4rpx; }

/* ====== 退出登录 ====== */
.logout-card {
  margin: 30rpx 20rpx 40rpx;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.logout-info { font-size: 24rpx; color: #999; }
.logout-btn {
  padding: 14rpx 32rpx;
  border-radius: 32rpx;
  background: #f5f5f5;
  font-size: 26rpx;
  color: #d63031;
  font-weight: 600;
}
.logout-btn:active { background: #ffe8e8; }
