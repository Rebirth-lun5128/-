/* ====== 欢迎横幅 ====== */
.welcome-banner {
  background: linear-gradient(135deg, #1a1940, #2d2b6b, #3d3b9b);
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(26,25,64,0.3);
}
.welcome-text { display: flex; flex-direction: column; }
.welcome-hi {
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
}
.welcome-sub {
  color: rgba(255,255,255,0.5);
  font-size: 24rpx;
  margin-top: 6rpx;
}
.welcome-quick { display: flex; flex-direction: column; gap: 6rpx; }
.welcome-stat {
  color: rgba(255,255,255,0.7);
  font-size: 22rpx;
  text-align: right;
}

/* ====== KPI 卡片网格 ====== */
.kpi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.kpi-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  position: relative;
  overflow: hidden;
}
.kpi-card::after {
  content: '';
  position: absolute;
  width: 80rpx; height: 80rpx;
  border-radius: 50%;
  background: var(--bg);
  right: -20rpx; bottom: -20rpx;
  opacity: 0.15;
}
.kpi-icon { font-size: 36rpx; margin-bottom: 8rpx; }
.kpi-value {
  font-size: 36rpx;
  font-weight: 800;
  color: #2d3436;
  line-height: 1.2;
}
.kpi-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.kpi-arrow {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  background: rgba(0,0,0,0.08);
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.kpi-hover {
  opacity: 0.85;
  transform: scale(0.97);
  transition: all 0.15s ease;
}

/* ====== 访问量卡片 ====== */
.visits-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 20rpx;
}
.visits-card {
  flex: 1;
  background: #fff;
  border-radius: 18rpx;
  padding: 20rpx 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.03);
}
.visits-num {
  font-size: 32rpx;
  font-weight: 800;
}
.visits-label {
  font-size: 20rpx;
  color: #bbb;
  margin-top: 4rpx;
}
.visits-card.today .visits-num { color: #6C5CE7; }
.visits-card.yesterday .visits-num { color: #636e72; }
.visits-card.total .visits-num { color: #00B894; }

/* ====== 次要指标 ====== */
.sub-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.sub-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.sub-card-top {
  display: flex;
  flex-direction: column;
  margin-bottom: 12rpx;
}
.sub-num {
  font-size: 38rpx;
  font-weight: 800;
}
.sub-num.warn { color: #E17055; }
.sub-num.danger { color: #d63031; }
.sub-num.info { color: #6C5CE7; }
.sub-num.green { color: #00B894; }
.sub-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 2rpx;
}
.sub-link {
  font-size: 24rpx;
  color: #6C5CE7;
  font-weight: 600;
}
.sub-rate {
  font-size: 22rpx;
  color: #bbb;
}

/* ====== 趋势图表 ====== */
.chart-card { padding-bottom: 12rpx; }
.chart-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 260rpx;
  padding-top: 20rpx;
}
.chart-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  justify-content: flex-end;
}
.bar-count {
  font-size: 20rpx;
  color: #999;
  margin-bottom: 6rpx;
  font-weight: 600;
}
.bar-track {
  width: 40rpx;
  height: 200rpx;
  background: #f0f0f5;
  border-radius: 10rpx 10rpx 0 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
}
.bar-fill {
  width: 100%;
  border-radius: 10rpx 10rpx 0 0;
  background: linear-gradient(180deg, #A29BFE, #6C5CE7);
  min-height: 6rpx;
  transition: height 0.6s ease;
}
.bar-label {
  font-size: 20rpx;
  color: #bbb;
  margin-top: 8rpx;
}

/* ====== 快捷操作 ====== */
.quick-section {
  margin-bottom: 20rpx;
}
.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 16rpx;
}
.quick-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.quick-item:active {
  background: #f8f7ff;
}
.quick-icon { font-size: 36rpx; }
.quick-txt { font-size: 22rpx; color: #666; font-weight: 500; }
.sub-hover { opacity: 0.8; transform: scale(0.97); }
.quick-hover { opacity: 0.7; }
