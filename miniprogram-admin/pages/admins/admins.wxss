.container { padding: 24rpx; padding-bottom: 40rpx; }
.head-bar {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 24rpx;
}
.head-title { font-size: 30rpx; font-weight: 700; color: #333; }
.btn-create {
  padding: 12rpx 28rpx; border-radius: 30rpx;
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
  color: #fff; font-size: 24rpx; font-weight: 600;
  border: none;
}
.empty { text-align: center; padding: 80rpx 0; color: #ccc; font-size: 26rpx; }

.admin-item {
  display: flex; justify-content: space-between; align-items: center;
  background: #fff; border-radius: 16rpx; padding: 22rpx 22rpx;
  margin-bottom: 14rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.03);
}
.ai-left { display: flex; flex-direction: column; gap: 6rpx; }
.ai-name { font-size: 28rpx; font-weight: 600; color: #333; }
.ai-phone { font-size: 24rpx; color: #999; }
.ai-tags { display: flex; gap: 10rpx; margin-top: 4rpx; }
.ai-role {
  font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 10rpx;
  background: #f0edff; color: #6C5CE7; font-weight: 600;
}
.ai-role.super_admin { background: #FFEBEE; color: #d63031; }
.ai-status {
  font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 10rpx;
}
.ai-status.on { background: #E8F5E9; color: #00B894; }
.ai-status.off { background: #f5f5f5; color: #999; }
.ai-right { display: flex; gap: 16rpx; }
.ai-action {
  font-size: 24rpx; color: #6C5CE7; font-weight: 600;
  padding: 8rpx 16rpx;
}
.ai-action.danger { color: #d63031; }

/* 弹窗 */
.mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4); z-index: 100;
}
.dialog {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff; border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 28rpx 40rpx; z-index: 101;
  max-height: 80vh; overflow-y: auto;
}
.dialog-title { font-size: 30rpx; font-weight: 700; color: #333; display: block; margin-bottom: 24rpx; }
.form-item { margin-bottom: 18rpx; }
.form-label { font-size: 24rpx; color: #666; margin-bottom: 8rpx; display: block; }
.form-input {
  background: #f5f6fa; border-radius: 12rpx;
  padding: 16rpx 20rpx; font-size: 28rpx; color: #333;
}
.form-picker {
  background: #f5f6fa; border-radius: 12rpx;
  padding: 16rpx 20rpx; font-size: 28rpx; color: #333;
}
.dialog-btns { display: flex; gap: 16rpx; margin-top: 24rpx; }
.btn-cancel {
  flex: 1; padding: 20rpx 0; border-radius: 40rpx;
  background: #f5f5f5; color: #666; font-size: 28rpx; border: none; text-align: center;
}
.btn-save {
  flex: 1; padding: 20rpx 0; border-radius: 40rpx;
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
  color: #fff; font-size: 28rpx; font-weight: 600; border: none; text-align: center;
}
.btn-save[disabled] { opacity: 0.5; }
