<view class="login-page">
  <!-- 品牌区 -->
  <view class="login-brand">
    <view class="brand-icon-wrap">
      <text class="brand-icon">🍜</text>
    </view>
    <text class="brand-title">夜市管理后台</text>
    <text class="brand-sub">社区外卖平台</text>
  </view>

  <!-- 表单 -->
  <view class="login-card">
    <view class="login-form-item">
      <text class="login-label">手机号</text>
      <input
        class="login-input"
        placeholder="请输入手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
        type="number"
        maxlength="11"
      />
    </view>
    <view class="login-form-item">
      <text class="login-label">密码</text>
      <view class="pwd-row">
        <input
          class="login-input pwd-input"
          type="text"
          password="{{!showPwd}}"
          placeholder="请输入密码"
          value="{{password}}"
          bindinput="onPwdInput"
        />
        <view class="pwd-toggle" bindtap="togglePwd">
          <text>{{showPwd ? '🙈' : '👁️'}}</text>
        </view>
      </view>
    </view>

    <button
      class="login-btn"
      bindtap="doLogin"
      loading="{{loading}}"
      disabled="{{loading}}"
    >
      {{loading ? '登录中...' : '登 录'}}
    </button>
  </view>

  <view class="login-tip">
    <text>仅限已授权的管理员登录</text>
    <text>测试账号：13800000000 / admin123</text>
  </view>
</view>
