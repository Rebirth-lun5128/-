.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1940 0%, #2d2b6b 50%, #3d3b9b 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 180rpx 60rpx 80rpx;
}

/* 品牌区 */
.login-brand {
  text-align: center;
  margin-bottom: 60rpx;
}
.brand-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, rgba(108,92,231,0.4), rgba(162,155,254,0.2));
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 28rpx;
  backdrop-filter: blur(10rpx);
}
.brand-icon { font-size: 56rpx; }
.brand-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
}
.brand-sub {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.5);
  margin-top: 10rpx;
}

/* 表单卡片 */
.login-card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.3);
}
.login-form-item {
  margin-bottom: 32rpx;
}
.login-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #999;
  margin-bottom: 12rpx;
}
.login-input {
  background: #f8f9fc;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 32rpx;
  border: 2rpx solid transparent;
}
.login-input:focus {
  border-color: #6C5CE7;
  background: #fff;
}

.pwd-row {
  display: flex;
  align-items: center;
}
.pwd-input { flex: 1; }
.pwd-toggle {
  padding: 0 16rpx;
  font-size: 36rpx;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  margin-top: 16rpx;
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
  color: #fff;
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: 700;
  padding: 26rpx 0;
  border: none;
  letter-spacing: 8rpx;
  box-shadow: 0 8rpx 28rpx rgba(108,92,231,0.35);
}
.login-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* 提示 */
.login-tip {
  margin-top: 60rpx;
  text-align: center;
}
.login-tip text {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.45);
  line-height: 1.8;
}
