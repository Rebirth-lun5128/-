<view class="container">
  <!-- 发送通知表单 -->
  <view class="card send-card">
    <text class="section-title">📢 发送推送通知</text>
    <view class="form-item">
      <text class="form-label">通知标题</text>
      <input class="form-input" placeholder="请输入通知标题" maxlength="100" value="{{title}}" bindinput="onTitleInput" />
    </view>
    <view class="form-item">
      <text class="form-label">通知内容</text>
      <textarea class="form-textarea" placeholder="请输入通知内容" maxlength="500" value="{{content}}" bindinput="onContentInput" />
    </view>
    <view class="form-item">
      <text class="form-label">目标角色</text>
      <picker mode="selector" range="{{['用户','商家','骑手','全部']}}" value="0" bindchange="onRoleChange">
        <view class="form-picker">{{targetRoleLabel}}</view>
      </picker>
    </view>
    <view class="form-btn-wrap">
      <button class="btn-send" bindtap="sendNotification" loading="{{sending}}" disabled="{{!title}}">立即发送</button>
    </view>
  </view>

  <!-- 发送记录 -->
  <view class="card history-card">
    <text class="section-title">📋 发送记录</text>
    <view wx:if="{{items.length === 0 && !loading}}" class="empty-hint">暂无发送记录</view>
    <view class="notif-item" wx:for="{{items}}" wx:key="id">
      <view class="ni-header">
        <text class="ni-title">{{item.title}}</text>
        <text class="ni-role">{{item.roleLabel}}</text>
      </view>
      <text class="ni-content">{{item.content}}</text>
      <text class="ni-time">{{item.created_at.slice(0, 16)}}</text>
    </view>
  </view>
</view>
