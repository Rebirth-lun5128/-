.container { padding: 24rpx; padding-bottom: 40rpx; }
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

/* 发送表单 */
.form-item { margin-bottom: 18rpx; }
.form-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: block;
}
.form-input {
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #333;
}
.form-textarea {
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #333;
  min-height: 160rpx;
  width: 100%;
  box-sizing: border-box;
}
.form-picker {
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #333;
}
.form-btn-wrap {
  display: flex;
  justify-content: flex-end;
  margin-top: 10rpx;
}
.btn-send {
  padding: 18rpx 48rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  border: none;
}
.btn-send[disabled] {
  opacity: 0.5;
}

/* 发送记录 */
.empty-hint {
  text-align: center;
  padding: 40rpx 0;
  color: #ccc;
  font-size: 24rpx;
}
.notif-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.notif-item:last-child { border-bottom: none; }
.ni-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.ni-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}
.ni-role {
  font-size: 22rpx;
  color: #6C5CE7;
  background: #f0edff;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.ni-content {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ni-time {
  font-size: 20rpx;
  color: #bbb;
}
