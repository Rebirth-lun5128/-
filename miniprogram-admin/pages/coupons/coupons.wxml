<view class="container">
  <!-- 优惠券统计 -->
  <view class="coupon-summary" wx:if="{{coupons.length > 0}}">
    <text>共 <text class="sum-num">{{coupons.length}}</text> 张优惠券</text>
  </view>

  <view class="empty-state" wx:if="{{coupons.length === 0 && !loading}}">
    <text class="empty-icon">🎫</text>
    <text>暂无优惠券</text>
    <text class="empty-hint">点击下方按钮创建第一张</text>
  </view>

  <!-- 优惠券卡片 -->
  <view class="coupon-card card" wx:for="{{coupons}}" wx:key="id">
    <view class="cc-left">
      <view class="cc-amount">
        <text class="cc-symbol">¥</text>
        <text class="cc-num">{{item.discount_amount}}</text>
      </view>
      <text class="cc-type">{{item.coupon_type === 'full_reduction' ? '满减券' : item.coupon_type === 'direct_discount' ? '立减券' : '新用户券'}}</text>
    </view>
    <view class="cc-divider-dashed"></view>
    <view class="cc-right">
      <view class="cc-name-row">
        <text class="cc-name">{{item.name}}</text>
        <text class="cc-status {{item.status === 1 ? 'on' : 'off'}}">{{item.status === 1 ? '启用' : '停用'}}</text>
      </view>
      <text class="cc-condition" wx:if="{{item.condition_amount > 0}}">满{{item.condition_amount}}元可用</text>
      <text class="cc-condition" wx:else>无门槛</text>
      <view class="cc-meta">
        <text>已领 {{item.used_count || 0}} / {{item.total_count || '∞'}}</text>
        <text wx:if="{{item.start_time}}">{{item.start_time.slice(0,10)}} ~ {{item.end_time ? item.end_time.slice(0,10) : '长期'}}</text>
      </view>
      <view class="cc-actions">
        <text class="cc-act edit" bindtap="goToEdit" data-id="{{item.id}}">编辑</text>
        <text class="cc-act {{item.status === 1 ? 'stop' : 'start'}}" bindtap="toggleStatus" data-id="{{item.id}}" data-status="{{item.status}}">
          {{item.status === 1 ? '停用' : '启用'}}
        </text>
      </view>
    </view>
  </view>

  <!-- 创建按钮 -->
  <view class="btn-primary btn-fab" bindtap="goToCreate">+ 创建优惠券</view>
</view>
