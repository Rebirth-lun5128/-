<view class="container" wx:if="{{order}}">
  <!-- 订单头部 -->
  <view class="od-hero">
    <view class="od-hero-top">
      <text class="od-no">#{{order.order_no}}</text>
      <text class="od-status-badge {{order.status}}">{{statusText(order.status)}}</text>
    </view>
    <view class="od-hero-price">
      <text class="od-price-symbol">¥</text>
      <text class="od-price-num">{{order.total_price}}</text>
    </view>
    <view class="od-hero-meta">
      <text>下单: {{order.created_at.slice(0, 16)}}</text>
      <text wx:if="{{order.paid_at}}">支付: {{order.paid_at.slice(0, 16)}}</text>
    </view>
  </view>

  <!-- 配送地址 -->
  <view class="card od-section">
    <view class="section-head">
      <text class="section-icon">📍</text>
      <text class="section-title">收货信息</text>
    </view>
    <view class="address-content">
      <text class="addr-name">{{order.address_snapshot.contact_name || '—'}}  {{order.address_snapshot.contact_phone || ''}}</text>
      <text class="addr-detail">{{order.address_snapshot.address || order.address_snapshot.full_address || '—'}}</text>
    </view>
  </view>

  <!-- 骑手信息 -->
  <view class="card od-section" wx:if="{{order.rider_name}}">
    <view class="section-head">
      <text class="section-icon">🛵</text>
      <text class="section-title">配送骑手</text>
    </view>
    <view class="info-row">
      <text class="ir-label">姓名</text>
      <text class="ir-val">{{order.rider_name}}</text>
    </view>
    <view class="info-row">
      <text class="ir-label">电话</text>
      <text class="ir-val">{{order.rider_phone}}</text>
    </view>
  </view>

  <!-- 费用明细 -->
  <view class="card od-section">
    <view class="section-head">
      <text class="section-icon">💰</text>
      <text class="section-title">费用明细</text>
    </view>
    <view class="info-row">
      <text class="ir-label">商品合计</text>
      <text class="ir-val">¥{{order.items_total}}</text>
    </view>
    <view class="info-row">
      <text class="ir-label">配送费</text>
      <text class="ir-val">
        ¥{{order.delivery_fee}}
        <text wx:if="{{order.delivery_fee_discount > 0}}" class="fee-discount">(已优惠¥{{order.delivery_fee_discount}})</text>
      </text>
    </view>
    <view class="info-row total">
      <text class="ir-label">实付金额</text>
      <text class="ir-val price">¥{{order.total_price}}</text>
    </view>
  </view>

  <!-- 用户备注 -->
  <view class="card od-section" wx:if="{{order.remark}}">
    <view class="section-head">
      <text class="section-icon">📝</text>
      <text class="section-title">用户备注</text>
    </view>
    <text class="remark-text">{{order.remark}}</text>
  </view>

  <!-- 子单列表 -->
  <view class="od-section" wx:for="{{order.sub_orders}}" wx:key="id" wx:for-item="sub">
    <view class="card sub-card">
      <view class="sub-head">
        <view class="sub-head-left">
          <text class="sub-store-icon">🏪</text>
          <text class="sub-store-name">{{sub.store_name}}</text>
        </view>
        <text class="sub-status {{sub.status}}">{{statusText(sub.status)}}</text>
      </view>

      <!-- 商品列表 -->
      <view class="sub-items">
        <view class="sub-item" wx:for="{{sub.items}}" wx:key="id" wx:for-item="it">
          <text class="si-name">{{it.name}}</text>
          <view class="si-right">
            <text class="si-price">¥{{it.price}}</text>
            <text class="si-qty">x{{it.quantity}}</text>
          </view>
        </view>
      </view>

      <view class="sub-foot">
        <text>小计: ¥{{sub.items_total}}</text>
        <text wx:if="{{sub.cancel_reason}}" class="cancel-info">取消: {{sub.cancel_reason}}</text>
      </view>

      <!-- 子单时间线 -->
      <view class="timeline" wx:if="{{sub.timeline.length > 0}}">
        <view class="tl-item" wx:for="{{sub.timeline}}" wx:key="*this" wx:for-item="tl">
          <view class="tl-dot done"></view>
          <view class="tl-body">
            <text class="tl-desc">{{tl.description || statusText(tl.status)}}</text>
            <text class="tl-time">{{tl.created_at.slice(0, 16)}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="od-actions" wx:if="{{order.status !== 'completed' && order.status !== 'cancelled'}}">
    <view class="btn-danger btn-block" bindtap="forceCancel">强制取消订单</view>
    <text class="action-warn">此操作不可撤销，请谨慎执行</text>
  </view>

  <!-- 配送照片 -->
  <view class="card" wx:if="{{order.delivery_photo}}">
    <text class="section-title">📸 配送凭证</text>
    <image class="delivery-photo-img" src="{{order.delivery_photo}}" mode="widthFix" />
  </view>

  <view class="end-hint">— 订单详情 —</view>
</view>

<!-- 加载中 -->
<view class="loading-wrap" wx:if="{{!order && loading}}">
  <text class="loading-text">加载中...</text>
</view>
