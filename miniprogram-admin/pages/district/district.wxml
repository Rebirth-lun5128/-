<view class="container">
  <!-- 分区列表 -->
  <view class="section-label" wx:if="{{districts.length > 0}}">已创建的分区</view>
  <view class="district-card card" wx:for="{{districts}}" wx:key="id">
    <view class="dc-head">
      <view class="dc-name-row">
        <text class="dc-icon">🏘️</text>
        <text class="dc-name">{{item.name}}</text>
      </view>
      <text class="dc-edit" bindtap="editDistrict" data-district="{{item}}">✎ 编辑</text>
    </view>

    <!-- 覆盖小区 -->
    <view class="dc-tags" wx:if="{{item.coverage && item.coverage.length > 0}}">
      <text class="dc-tag" wx:for="{{item.coverage}}" wx:key="*this" wx:for-item="c">{{c}}</text>
    </view>
    <text class="dc-empty" wx:else>未设置覆盖小区</text>

    <view class="dc-divider"></view>

    <view class="dc-meta">
      <view class="dc-meta-item">
        <text class="dc-meta-val">{{item.delivery_fee}}分</text>
        <text class="dc-meta-label">配送费</text>
      </view>
      <view class="dc-meta-item">
        <text class="dc-meta-val">{{item.delivery_range}}km</text>
        <text class="dc-meta-label">配送范围</text>
      </view>
      <view class="dc-meta-item" wx:if="{{item.notice}}">
        <text class="dc-meta-val notice" wx:if="{{item.notice.length > 10}}">{{item.notice.slice(0,10)}}...</text>
        <text class="dc-meta-val notice" wx:else>{{item.notice}}</text>
        <text class="dc-meta-label">公告</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{districts.length === 0}}">
    <text class="empty-icon">🗺️</text>
    <text>暂无分区，请创建一个</text>
  </view>

  <!-- 编辑/创建表单 -->
  <view class="card form-card">
    <view class="form-head">
      <text class="form-head-icon">{{editing ? '✏️' : '➕'}}</text>
      <text class="form-head-title">{{editing ? '编辑分区' : '新建分区'}}</text>
    </view>

    <view class="form-item">
      <text class="fi-label">分区名称 <text class="required">*</text></text>
      <input class="fi-input" placeholder="如: 阳光花园社区" value="{{form.name}}" bindinput="onInput" data-field="name" />
    </view>
    <view class="form-item">
      <text class="fi-label">覆盖小区</text>
      <input class="fi-input" placeholder="用逗号分隔，如: 阳光花园,翠苑新村" value="{{form.coverage}}" bindinput="onInput" data-field="coverage" />
    </view>
    <view class="form-row">
      <view class="form-item half">
        <text class="fi-label">配送费(分)</text>
        <input class="fi-input" type="number" placeholder="0" value="{{form.delivery_fee}}" bindinput="onInput" data-field="delivery_fee" />
      </view>
      <view class="form-item half">
        <text class="fi-label">范围(km)</text>
        <input class="fi-input" type="digit" placeholder="3" value="{{form.delivery_range}}" bindinput="onInput" data-field="delivery_range" />
      </view>
    </view>
    <view class="form-item">
      <text class="fi-label">分区公告</text>
      <input class="fi-input" placeholder="公告内容（选填）" value="{{form.notice}}" bindinput="onInput" data-field="notice" />
    </view>

    <view class="form-actions">
      <view class="btn-primary" bindtap="saveDistrict">{{editing ? '保存修改' : '创建分区'}}</view>
      <view class="btn-cancel" wx:if="{{editing}}" bindtap="resetForm">取消编辑</view>
    </view>
  </view>
</view>
