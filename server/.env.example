# 环境变量配置文件
# 复制此文件为 .env 并填入实际值

# 应用
DEBUG=false

# 数据库
# SQLite（开发）：
DATABASE_URL=sqlite:///./food_delivery.db
# MySQL（生产）：
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/food_delivery?charset=utf8mb4

# JWT — 生产环境必须设置！
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-please

# Redis（可选 — 多worker部署时必需）
# REDIS_URL=redis://localhost:6379/0

# CORS 白名单（逗号分隔，* 表示允许全部）
CORS_ORIGINS=*

# 微信小程序
WECHAT_APPID=your_appid
WECHAT_SECRET=your_secret

# 微信支付
WECHAT_PAY_MCHID=your_mchid
WECHAT_PAY_API_V3_KEY=your_api_v3_key
WECHAT_PAY_SERIAL_NO=your_serial_no
WECHAT_PAY_PRIVATE_KEY=your_private_key_path
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/common/pay/notify

# 文件上传目录
UPLOAD_DIR=./uploads
